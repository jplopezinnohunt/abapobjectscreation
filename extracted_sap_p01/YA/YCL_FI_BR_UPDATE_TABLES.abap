                                       AND   REFBT = @IS_FMIOI-REFBT
                                       AND   RFORG = @IS_FMIOI-RFORG
                                       AND   RFPOS = @IS_FMIOI-RFPOS
                                       AND   RFKNT = @IS_FMIOI-RFKNT
                                       AND   RFETE = @IS_FMIOI-RFETE
                                       AND   RCOND = @IS_FMIOI-RCOND
                                       AND   RFTYP = @IS_FMIOI-RFTYP
                                       AND   RFSYS = @IS_FMIOI-RFSYS
                                       AND   BTART = @IS_FMIOI-BTART
                                       AND   RLDNR = @IS_FMIOI-RLDNR
                                       AND   GJAHR = @IS_FMIOI-GJAHR
                                       AND   STUNR = @IS_FMIOI-STUNR
                    INTO @LS_BR_FMIOI.
