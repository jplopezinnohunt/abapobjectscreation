* ---- YCL_FI_BR_UPDATE_TABLES=======CM001 ----
  METHOD UPDATE_BR_FMIFIIT.

    DATA LS_BR_FMIFIIT TYPE YTFM_BR_FMIFIIT.

    IF IS_FMIFIIT IS INITIAL.
      EV_SUBRC = 8.
      EXIT.
    ENDIF.

    SELECT SINGLE * FROM YTFM_BR_FMIFIIT WHERE FMBELNR = @IS_FMIFIIT-FMBELNR
                                         AND   FIKRS = @IS_FMIFIIT-FIKRS
                                         AND   FMBUZEI = @IS_FMIFIIT-FMBUZEI
                                         AND   BTART = @IS_FMIFIIT-BTART
                                         AND   RLDNR = @IS_FMIFIIT-RLDNR
                                         AND   GJAHR = @IS_FMIFIIT-GJAHR
                                         AND   STUNR = @IS_FMIFIIT-STUNR
                    INTO @LS_BR_FMIFIIT.
    IF SY-SUBRC = 0.
      LS_BR_FMIFIIT-ZFKBTR = IS_FMIFIIT-FKBTR.
      LS_BR_FMIFIIT-ZTRBTR = IS_FMIFIIT-TRBTR.
      LS_BR_FMIFIIT-TWAER = IS_FMIFIIT-TWAER.
      LS_BR_FMIFIIT-CPUDT = SY-DATUM.
      LS_BR_FMIFIIT-CPUTM = SY-UZEIT.
      LS_BR_FMIFIIT-USNAM = SY-UNAME.
      LS_BR_FMIFIIT-TCODE = SY-TCODE.
      UPDATE YTFM_BR_FMIFIIT FROM LS_BR_FMIFIIT.
      EV_SUBRC = SY-SUBRC.
    ELSE.
      MOVE-CORRESPONDING IS_FMIFIIT TO LS_BR_FMIFIIT.
      LS_BR_FMIFIIT-ZFKBTR = IS_FMIFIIT-FKBTR.
      LS_BR_FMIFIIT-ZTRBTR = IS_FMIFIIT-TRBTR.
      LS_BR_FMIFIIT-CPUDT = SY-DATUM.
      LS_BR_FMIFIIT-CPUTM = SY-UZEIT.
      LS_BR_FMIFIIT-USNAM = SY-UNAME.
      LS_BR_FMIFIIT-TCODE = SY-TCODE.
      INSERT YTFM_BR_FMIFIIT FROM LS_BR_FMIFIIT.
      EV_SUBRC = SY-SUBRC.
    ENDIF.

  ENDMETHOD.

