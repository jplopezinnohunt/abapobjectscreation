  METHOD UPDATE_BR_FM_POS.

    SELECT SINGLE * FROM YTFM_BR_FM_POS WHERE ENC_TYPE = @IV_ENC_TYPE
                                        AND   BELNR = @IV_BELNR
                                        AND   FPM_POSNR = @IV_FPM_POSNR
                    INTO @DATA(LS_FM_POS).
    IF SY-SUBRC = 0.
      LS_FM_POS-BETRG_BEFORE = IV_BETRG_BEFORE.
      LS_FM_POS-BWAER_BEFORE = IV_BWAER_BEFORE.
      LS_FM_POS-BETRG_AFTER = IV_BETRG_AFTER.
      LS_FM_POS-DELTA_BEFORE = IV_DELTA_BEFORE.
      LS_FM_POS-DWAER_BEFORE = IV_DWAER_BEFORE.
      LS_FM_POS-DELTA_AFTER = IV_DELTA_AFTER.
      LS_FM_POS-WAERS_AFTER = IV_WAERS_AFTER.
      LS_FM_POS-CPUDT = SY-DATUM.
      LS_FM_POS-CPUTM = SY-UZEIT.
      LS_FM_POS-USNAM = SY-UNAME.
      LS_FM_POS-TCODE = SY-TCODE.
      UPDATE YTFM_BR_FM_POS FROM LS_FM_POS.
      EV_SUBRC = SY-SUBRC.
    ELSE.
      LS_FM_POS-ENC_TYPE = IV_ENC_TYPE.
      LS_FM_POS-BELNR = IV_BELNR.
      LS_FM_POS-FPM_POSNR = IV_FPM_POSNR.
      LS_FM_POS-BETRG_BEFORE = IV_BETRG_BEFORE.
      LS_FM_POS-BWAER_BEFORE = IV_BWAER_BEFORE.
      LS_FM_POS-BETRG_AFTER = IV_BETRG_AFTER.
      LS_FM_POS-DELTA_BEFORE = IV_DELTA_BEFORE.
      LS_FM_POS-DWAER_BEFORE = IV_DWAER_BEFORE.
      LS_FM_POS-DELTA_AFTER = IV_DELTA_AFTER.
      LS_FM_POS-WAERS_AFTER = IV_WAERS_AFTER.
      LS_FM_POS-CPUDT = SY-DATUM.
      LS_FM_POS-CPUTM = SY-UZEIT.
      LS_FM_POS-USNAM = SY-UNAME.
      LS_FM_POS-TCODE = SY-TCODE.
      INSERT YTFM_BR_FM_POS FROM LS_FM_POS.
      EV_SUBRC = SY-SUBRC.
    ENDIF.

  ENDMETHOD.

