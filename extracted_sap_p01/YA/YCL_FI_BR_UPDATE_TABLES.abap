      LS_BR_FMIOI-ZTRBTR = IS_FMIOI-TRBTR.
      LS_BR_FMIOI-CPUDT = SY-DATUM.
      LS_BR_FMIOI-CPUTM = SY-UZEIT.
      LS_BR_FMIOI-USNAM = SY-UNAME.
