             WBS_UP   TYPE PS_PHIUP,
             WBS_DOWN TYPE PS_PHIDO,
           END OF TY_WBS_UP_DOWN .
  TYPES:
    TTY_WBS_UP_DOWN TYPE TABLE OF TY_WBS_UP_DOWN .

  DATA MT_WBS_UP_DOWN TYPE TTY_WBS_UP_DOWN .
  DATA MT_PRHI TYPE TT_PRHI .

  CLASS-METHODS CALL_PROJECT_TRANSACTION
    IMPORTING
      !IV_PROJECT TYPE PS_PSPID
      !IV_MODE TYPE C DEFAULT 'D' .
  METHODS SET_PRHI_TO_UP_DOWN .