* ---- YCL_FI_JCU_MANAGEMENT_BL======CM00B ----
  METHOD LOCK_JCU_TABLE.

    CALL FUNCTION 'ENQUEUE_EYFI_JCU'
      EXPORTING
        MODE_YTFI_JCU  = 'E'
        MANDT          = SY-MANDT
        BUKRS          = IV_BUKRS
        GJAHR          = IV_GJAHR
*       X_BUKRS        = ' '
*       X_GJAHR        = ' '
*       _SCOPE         = '2'
*       _WAIT          = ' '
*       _COLLECT       = ' '
      EXCEPTIONS
        FOREIGN_LOCK   = 1
        SYSTEM_FAILURE = 2
        OTHERS         = 3.

    IF SY-SUBRC <> 0.
      MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
            WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4 INTO EV_MESSAGE.
    ELSE.
      EV_LOCKED = ABAP_TRUE.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FI_JCU_MANAGEMENT_BL======CM00C ----
  METHOD UNLOCK_JCU_TABLE.

    CALL FUNCTION 'DEQUEUE_EYFI_JCU'
      EXPORTING
        MODE_YTFI_JCU = 'E'
        MANDT         = SY-MANDT
        BUKRS         = IV_BUKRS
        GJAHR         = IV_GJAHR.

  ENDMETHOD.

