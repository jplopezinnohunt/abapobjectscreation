  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'S_RACCT7' IV_KIND = 'S' IT_VALUE = S_RACCT7[] ).
  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'S_RBUSA7' IV_KIND = 'S' IT_VALUE = S_RBUSA7[] ).
