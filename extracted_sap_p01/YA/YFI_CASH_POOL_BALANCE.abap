  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'S_RACCTI' IV_KIND = 'S' IT_VALUE = S_RACCTI[] ).
  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'S_RACCTJ' IV_KIND = 'S' IT_VALUE = S_RACCTJ[] ).
  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'S_RACCTK' IV_KIND = 'S' IT_VALUE = S_RACCTK[] ).
  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'S_RACCTL' IV_KIND = 'S' IT_VALUE = S_RACCTL[] ).
  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'S_RACCTM' IV_KIND = 'S' IT_VALUE = S_RACCTM[] ).
  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'S_RACCTN' IV_KIND = 'S' IT_VALUE = S_RACCTN[] ).

  "Get data for report
  GO_CASH_POOL_BALANCE_BL->GET_DATA( ).

  "Display list
  GO_CASH_POOL_BALANCE_BL->DISPLAY_ALV( SY-REPID ).