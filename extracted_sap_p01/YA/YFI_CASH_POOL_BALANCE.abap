START-OF-SELECTION.

  GO_CASH_POOL_BALANCE_BL = NEW YCL_FI_CASH_POOL_BALANCE_BL( ).
  "Set selection-screen data to business class
  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'P_GJAHR' IV_KIND = 'P' IV_VALUE = P_GJAHR ).
  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'S_PERIO' IV_KIND = 'S' IT_VALUE = S_PERIO[] ).
  "Criteria: cash pool unes
  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'P_BUKRS1' IV_KIND = 'P' IV_VALUE = P_BUKRS1 ).
  GO_CASH_POOL_BALANCE_BL->SET_SELECTION_VALUES( IV_SELNAME = 'S_RACCT1' IV_KIND = 'S' IT_VALUE = S_RACCT1[] ).
