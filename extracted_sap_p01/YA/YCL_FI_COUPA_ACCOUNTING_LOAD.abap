      VALUE(RV_ID) TYPE NUM7 .
  METHODS MANAGE_RFBIBL00_PROTOCOL
    IMPORTING
      !IT_MESSAGE TYPE FB_T_FIMSG
      !IV_ERROR_RUN TYPE XFELD
      !IT_BIBL_FILE TYPE YTT_STRING
      !IS_RFBIBL_DATA TYPE YSFI_RFBIBL00_DATA
