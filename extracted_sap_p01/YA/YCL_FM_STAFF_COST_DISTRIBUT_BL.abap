        LO_AGGREGATIONS->ADD_AGGREGATION( COLUMNNAME = 'COMMITMENT'
                                          AGGREGATION = IF_SALV_C_AGGREGATION=>TOTAL ).
      CATCH CX_SALV_ERROR.
    ENDTRY.

