    ENDTRY.

    TRY.
        LO_COLUMN ?= LO_COLUMNS->GET_COLUMN( 'COMMITMENT' ).
        LO_COLUMN->SET_CELL_TYPE( IF_SALV_C_CELL_TYPE=>HOTSPOT ).
        LO_COLUMN->SET_LONG_TEXT( 'Commitment not realized' ).
        LO_COLUMN->SET_FIXED_HEADER_TEXT( 'L' ).
