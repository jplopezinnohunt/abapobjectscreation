* ---- YCL_IM__FI_VENDOR_MR==========CM005 ----
METHOD IF_EX_VENDOR_ADD_DATA_CS~GET_TAXI_SCREEN.
  CASE I_TAXI_FCODE.
    WHEN 'Z1UN01'.
      IF SY-TCODE = 'XK03' OR SY-TCODE = 'FK03'.
        E_SCREEN  = '0300'.
       ELSE.
         E_SCREEN  = '0100'.
      ENDIF.
      E_PROGRAM = 'SAPLYFI_VENDOR_MR'.
      E_HEADERSCREEN_LAYOUT = ' '.
    WHEN OTHERS.
  ENDCASE.
ENDMETHOD.

