* ---- YCL_IM__FI_VENDOR_MR==========CM001 ----
METHOD IF_EX_VENDOR_ADD_DATA_CS~SET_DATA.

DATA: W_LFBK TYPE FLFBK.

CLEAR W_LFBK.
LOOP AT T_LFBK INTO W_LFBK WHERE BKREF <> SPACE.
ENDLOOP. "T_LFBK

CALL FUNCTION 'Y_FI_VENDOR_EXTZ1_SETDATA'
  EXPORTING
    I_LIFNR = I_LFA1-LIFNR
    I_KTOKK = I_LFA1-KTOKK
    I_UNESDIR = I_LFA1-YYUNESDIR
    I_NATIO = I_LFA1-YYNATIO
    I_FFCRTO = W_LFBK-YYFFCRTO
    I_SDATE = I_LFA1-YYSDATE
    I_EDATE = I_LFA1-YYEDATE
    I_AUFNR = I_LFA1-YYAUFNR.

ENDMETHOD.

* ---- YCL_IM__FI_VENDOR_MR==========CM002 ----
METHOD IF_EX_VENDOR_ADD_DATA_CS~GET_DATA.

DATA: W_LFBK TYPE FLFBK,
      W_FFCRTO TYPE FLFBK-YYFFCRTO.

CALL FUNCTION 'Y_FI_VENDOR_EXTZ1_GETDATA'
  IMPORTING
    E_UNESDIR = S_LFA1-YYUNESDIR
    E_NATIO = S_LFA1-YYNATIO
    E_FFCRTO = W_FFCRTO
    E_SDATE = S_LFA1-YYSDATE
    E_EDATE = S_LFA1-YYEDATE
    E_AUFNR = S_LFA1-YYAUFNR.

CLEAR W_LFBK.
LOOP AT T_LFBK INTO W_LFBK WHERE BKREF <> SPACE.
  W_LFBK-YYFFCRTO = W_FFCRTO.
  MODIFY T_LFBK FROM W_LFBK.
ENDLOOP. "T_LFBK

ENDMETHOD.

