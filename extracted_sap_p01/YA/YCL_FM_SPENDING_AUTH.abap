    IF IV_NON_IBF = ABAP_TRUE.
      DELETE FROM YTFM_FUND_CPL WHERE NONIBF = ABAP_TRUE.
      LV_SUBRC_NON_IBF = SY-SUBRC.
    ENDIF.

    IF LV_SUBRC_SISTER = 0 AND LV_SUBRC_NON_IBF = 0.
      RV_IS_OK = ABAP_TRUE.
    ENDIF.

