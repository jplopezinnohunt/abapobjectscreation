    DATA LO_ALV TYPE REF TO YIF_ALV_DISPLAY.

    DESCRIBE TABLE CT_TAB LINES DATA(LV_LINES).

    LO_ALV = YCL_ALV_FACTORY=>GET_INSTANCE( ).
