* ---- YCL_FM_SPENDING_AUTH==========CM00T ----
  METHOD GET_DATA_FROM_SISTER.

    DATA LS_FUND_AL TYPE TY_FUND_AL.

    CLEAR MT_FUND_AL.
    RV_IS_OK = ABAP_TRUE.

    "Open connexion with SISTER
    EXEC SQL.
      CONNECT TO 'SISTER' AS 'MYDB'
    ENDEXEC.

    EXEC SQL.
      SET CONNECTION 'MYDB'
    ENDEXEC.

    "Get data from SISTER table
    EXEC SQL.
      OPEN DBCUR FOR
      SELECT  CODE , MLAIMPLEMENTINGUNIT
      FROM PROJECTS
    ENDEXEC.

    DO.
      EXEC SQL.
        FETCH NEXT DBCUR INTO :LS_FUND_AL-FINCODE,
                              :LS_FUND_AL-ALINE
      ENDEXEC.
      IF SY-SUBRC <> 0.
        EXIT.
      ELSE.
        APPEND LS_FUND_AL TO MT_FUND_AL.
      ENDIF.
    ENDDO.

    EXEC SQL.
      CLOSE DBCUR
    ENDEXEC.

* Fermer la connexion
    EXEC SQL .
      DISCONNECT 'MYDB'
    ENDEXEC.

    IF MT_FUND_AL IS INITIAL.
      RV_IS_OK = ABAP_FALSE.
    ENDIF.

  ENDMETHOD.

