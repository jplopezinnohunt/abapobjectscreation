      !IV_TARGET_CURRENCY TYPE SYCURR
      !IV_DATE TYPE SY-DATUM OPTIONAL
    RETURNING
      VALUE(RV_FACTOR) TYPE YE_CA_DECIMAL_FACTOR .
  METHODS GET_DECIMAL_FACTOR
    IMPORTING
