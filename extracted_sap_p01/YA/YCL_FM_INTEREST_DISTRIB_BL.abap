* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00Z ----
  METHOD DISPLAY_CONSOLIDATED_LIST.

    DATA LO_COLUMN TYPE REF TO CL_SALV_COLUMN_TABLE.
    DATA LV_TEXT_L TYPE SCRTEXT_L.
    DATA LS_COLOR TYPE LVC_S_COLO.
    DATA LT_FIELDNAME TYPE TABLE OF FIELDNAME.
    DATA LV_FIELD TYPE FIELDNAME.
    DATA LV_LABEL TYPE SCRTEXT_L.
    DATA LV_TABIX TYPE SY-TABIX.
    DATA LO_FUNCTIONAL_SETTINGS TYPE REF TO CL_SALV_FUNCTIONAL_SETTINGS.
    DATA LO_TOOLTIPS TYPE REF TO CL_SALV_TOOLTIPS.
    DATA LV_VALUE TYPE LVC_VALUE.
    DATA LS_LAYOUT_KEY TYPE SALV_S_LAYOUT_KEY.
    DATA LO_LAYOUT TYPE REF TO CL_SALV_LAYOUT.
    DATA LO_EVENTS TYPE REF TO CL_SALV_EVENTS_TABLE.
    DATA LV_ICON TYPE STRING.

    "Set list type
    MV_LIST_TYPE = IV_LIST_TYPE.

    "Set ALV header list
    ME->DISPLAY_HEADER_LIST( ).

    "Set detailed list
    TRY.
        CL_SALV_TABLE=>FACTORY( EXPORTING R_CONTAINER  = MO_CONTAINER_ITEM
                                IMPORTING R_SALV_TABLE = MO_SALV_TABLE_ITEM
                                CHANGING  T_TABLE      = MT_LIST_CON_I ).
      CATCH CX_SALV_MSG .
    ENDTRY.

    DATA(LO_FUNCTIONS) = MO_SALV_TABLE_ITEM->GET_FUNCTIONS( ).
    DATA(LO_COLUMNS) = MO_SALV_TABLE_ITEM->GET_COLUMNS( ).
    "DATA(lo_layout) = mo_salv_table_item->get_layout( ).
    DATA(LO_DISPLAY_SETTINGS) = MO_SALV_TABLE_ITEM->GET_DISPLAY_SETTINGS( ).

    LO_FUNCTIONS->SET_ALL( ).
    LO_FUNCTIONS->SET_GRAPHICS( ABAP_FALSE ).

    "Add button icon legend
    LV_ICON = ICON_ICON_LIST.
    TRY.
        LO_FUNCTIONS->ADD_FUNCTION( NAME = 'YICON'
                                    ICON = LV_ICON
                                    TEXT = 'Icon legend'
                                    TOOLTIP = 'Meaning of icons'
                                    POSITION = IF_SALV_C_FUNCTION_POSITION=>RIGHT_OF_SALV_FUNCTIONS ).
      CATCH CX_SALV_EXISTING CX_SALV_WRONG_CALL.
    ENDTRY.

    LO_LAYOUT = MO_SALV_TABLE_ITEM->GET_LAYOUT( ).
    LS_LAYOUT_KEY-REPORT = SY-CPROG.
    LO_LAYOUT->SET_KEY( LS_LAYOUT_KEY ).
    LO_LAYOUT->SET_SAVE_RESTRICTION( IF_SALV_C_LAYOUT=>RESTRICT_USER_DEPENDANT ).

    LO_COLUMNS->SET_OPTIMIZE( ).
    LO_COLUMNS->SET_KEY_FIXATION( ABAP_TRUE ).
    LO_DISPLAY_SETTINGS->SET_STRIPED_PATTERN( ABAP_TRUE ).

    LO_EVENTS = MO_SALV_TABLE_ITEM->GET_EVENT( ).
    SET HANDLER ME->HANDLE_LINK_CLICK FOR LO_EVENTS.
    SET HANDLER ME->HANDLE_BOTTOM_LIST FOR LO_EVENTS.

    TRY.
        LO_COLUMN ?= LO_COLUMNS->GET_COLUMN( 'CODE_TO_CREDIT' ).
        LO_COLUMN->SET_FIXED_HEADER_TEXT( 'L' ).
        LO_COLUMN->SET_KEY( ABAP_TRUE ).
        LO_COLUMN->SET_CELL_TYPE( IF_SALV_C_CELL_TYPE=>HOTSPOT ).
      CATCH CX_SALV_NOT_FOUND.
    ENDTRY.

    TRY.
        LO_COLUMN ?= LO_COLUMNS->GET_COLUMN( 'POSTING_CHECK' ).
        LO_COLUMN->SET_FIXED_HEADER_TEXT( 'L' ).
        LO_COLUMN->SET_LONG_TEXT( 'Posting check' ).
        LO_COLUMN->SET_ICON( IF_SALV_C_BOOL_SAP=>TRUE ).
        LO_COLUMN->SET_KEY( ABAP_TRUE ).
      CATCH CX_SALV_NOT_FOUND.
    ENDTRY.

    TRY.
        LO_COLUMN ?= LO_COLUMNS->GET_COLUMN( 'DATAB' ).
        LO_COLUMN->SET_VISIBLE( IF_SALV_C_BOOL_SAP=>FALSE ).
      CATCH CX_SALV_NOT_FOUND.
    ENDTRY.

    TRY.
        LO_COLUMN ?= LO_COLUMNS->GET_COLUMN( 'DATBIS' ).
        LO_COLUMN->SET_VISIBLE( IF_SALV_C_BOOL_SAP=>FALSE ).
      CATCH CX_SALV_NOT_FOUND.
    ENDTRY.

    APPEND 'CASH_BAL_M' TO LT_FIELDNAME.
    APPEND 'PROPORTION_M' TO LT_FIELDNAME.
    APPEND 'INT_TO_DISTR_M' TO LT_FIELDNAME.
    APPEND 'INT_DISTRIB_M' TO LT_FIELDNAME.
    APPEND 'MCA_CREDIT_M' TO LT_FIELDNAME.

    LOOP AT LT_FIELDNAME INTO DATA(LV_FIELDNAME).
      LOOP AT MT_PERIOD INTO DATA(LS_PERIOD).
        LV_TABIX = SY-TABIX.
        LV_FIELD = |{ LV_FIELDNAME }{ LV_TABIX }|.
        TRY.
            LO_COLUMN ?= LO_COLUMNS->GET_COLUMN( LV_FIELD ).
            LV_LABEL = LO_COLUMN->GET_MEDIUM_TEXT( ).
            LV_LABEL = |{ LV_LABEL } { LS_PERIOD-MONTH }/{ LS_PERIOD-GJAHR }|.
            LO_COLUMN->SET_LONG_TEXT( LV_LABEL ).
            LO_COLUMN->SET_FIXED_HEADER_TEXT( 'L' ).
            IF LV_FIELDNAME = 'POST_RULE_M'.
              LO_COLUMN->SET_ALIGNMENT( IF_SALV_C_ALIGNMENT=>RIGHT ).
            ENDIF.
            "Set color
            CASE LV_TABIX.
              WHEN 1.
                LS_COLOR-COL = COL_GROUP.
              WHEN 2.
                LS_COLOR-COL = COL_TOTAL.
              WHEN 3.
                LS_COLOR-COL = COL_POSITIVE.
            ENDCASE.
            LO_COLUMN->SET_COLOR( LS_COLOR ).
          CATCH CX_SALV_NOT_FOUND.
        ENDTRY.
