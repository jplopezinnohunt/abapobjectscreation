* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00C ----
  METHOD SAVE_INT_DISTR.

    DATA LT_INSERT TYPE TABLE OF YTFM_INT_DISTR.
    DATA LT_UPDATE TYPE TABLE OF YTFM_INT_DISTR.
    DATA LV_TABIX TYPE SY-TABIX.
    DATA LV_SUBRC_UPDATE TYPE SY-SUBRC.
    DATA LV_SUBRC_INSERT TYPE SY-SUBRC.
    DATA LV_SUBRC_DELETE TYPE SY-SUBRC.

    IF MT_INT_DISTR = MT_INT_DISTR_O.
      MESSAGE 'No data to update' TYPE 'I'.
      EXIT.
    ENDIF.

    "Delete initial line from original
    DELETE MT_INT_DISTR_O WHERE IYEAR IS INITIAL.

    LOOP AT MT_INT_DISTR INTO DATA(LS_NEW).
      CHECK LS_NEW <> MS_INT_DISTR_DEFAULT.
      READ TABLE MT_INT_DISTR_O INTO DATA(LS_OLD) WITH KEY IYEAR = LS_NEW-IYEAR
                                                           IMONTH = LS_NEW-IMONTH.
      IF SY-SUBRC = 0.
        LV_TABIX = SY-TABIX.
        IF LS_NEW-POOLING_INT <> LS_OLD-POOLING_INT OR LS_NEW-WAERS <> LS_OLD-WAERS.
          LS_NEW-MUNAM = SY-UNAME.
          LS_NEW-MDATE = SY-DATUM.
          APPEND LS_NEW TO LT_UPDATE.
        ENDIF.
        DELETE MT_INT_DISTR_O INDEX LV_TABIX.
      ELSE.
        LS_NEW-CUNAM = SY-UNAME.
        LS_NEW-CDATE = SY-DATUM.
        APPEND LS_NEW TO LT_INSERT.
      ENDIF.
    ENDLOOP.

    "Update database
    "First delete entries not in new picture
    IF MT_INT_DISTR_O IS NOT INITIAL.
      DELETE YTFM_INT_DISTR FROM TABLE MT_INT_DISTR_O.
      LV_SUBRC_DELETE = SY-SUBRC.
    ENDIF.

    "Then update entries
    IF LT_UPDATE IS NOT INITIAL.
      UPDATE YTFM_INT_DISTR FROM TABLE LT_UPDATE.
      LV_SUBRC_UPDATE = SY-SUBRC.
    ENDIF.

    "And insert entries
    IF LT_INSERT IS NOT INITIAL.
      INSERT YTFM_INT_DISTR FROM TABLE LT_INSERT.
      LV_SUBRC_INSERT = SY-SUBRC.
    ENDIF.

    IF LV_SUBRC_DELETE = 0 AND LV_SUBRC_UPDATE = 0 AND LV_SUBRC_INSERT = 0.
      COMMIT WORK.
      MT_INT_DISTR_O = MT_INT_DISTR.
      MESSAGE 'Data saved' TYPE 'S'.
    ELSE.
      ROLLBACK WORK.
      MESSAGE 'Error during save' TYPE 'I'.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00D ----
  METHOD CHECK_MODIFIED_INT_DISTR.

    EV_MODIFIED = ABAP_FALSE.

    IF MT_INT_DISTR <> MT_INT_DISTR_O.
      EV_MODIFIED = ABAP_TRUE.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00E ----
  METHOD CHECK_BEFORE_EXIT.

    DATA LV_MODIFIED TYPE XFELD.
    DATA LV_VALID TYPE XFELD.

    RV_EXIT = ABAP_FALSE.
    MO_GRID->CHECK_CHANGED_DATA( IMPORTING E_VALID = LV_VALID ).
    IF LV_VALID = ABAP_FALSE.
      IF IV_FORCE_EXIT = ABAP_TRUE.
        IF YCL_CA_UTILITIES=>POPUP_TO_CONFIRM( IV_TITLE = 'Data modified and inconsistent'
                                               IV_TEXT = 'Data have been modified but inconsistent. Do you want to leave without saving ?' ) = '1'.   "Yes
          RV_EXIT = ABAP_TRUE.
          EXIT.
        ENDIF.
      ENDIF.
    ELSE.
      CALL METHOD (MV_CHECK_MODIFIED_METHOD) IMPORTING EV_MODIFIED = LV_MODIFIED.
      IF LV_MODIFIED = ABAP_TRUE.
        IF YCL_CA_UTILITIES=>POPUP_TO_CONFIRM( IV_TITLE = 'Data modified'
                                               IV_TEXT = 'Data have been modified. Do you want to leave without saving ?' ) = '1'.   "Yes
          RV_EXIT = ABAP_TRUE.
        ENDIF.
      ELSE.
        RV_EXIT = ABAP_TRUE.
      ENDIF.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00F ----
  METHOD MANAGE_CASH_BAL_INSTITUTE.

    DATA LS_LAYOUT TYPE LVC_S_LAYO.

    "Set default value
    MS_INT_CBINST_DEFAULT-MANDT = SY-MANDT.
    MS_INT_CBINST_DEFAULT-WAERS = C_USD.
    "Get initial data in DB
    ME->READ_INT_CBINST_FROM_DB( ).
    "Set initial line if no data
    IF MT_INT_CBINST IS INITIAL.
      APPEND MS_INT_CBINST_DEFAULT TO MT_INT_CBINST.
    ENDIF.
    "Initialize original table
    MT_INT_CBINST_O = MT_INT_CBINST.
    "Get field catalog
    ME->GET_FIELDCAT( IV_STRUCTURE = 'YTFM_INT_CBINST' ).
    "Set field properties
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'IYEAR' IV_KEY = ABAP_TRUE IV_EDIT = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'IMONTH' IV_KEY = ABAP_TRUE IV_EDIT = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'INSTITUTE' IV_KEY = ABAP_TRUE IV_EDIT = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'CASH_BAL' IV_EDIT = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'WAERS' IV_AUTO_VALUE = ABAP_TRUE ).

    MO_GRID->SET_TABLE_FOR_FIRST_DISPLAY( EXPORTING IT_TOOLBAR_EXCLUDING = MT_EXCLUDE_FCT
                                                    IS_LAYOUT = LS_LAYOUT
                                          CHANGING IT_FIELDCATALOG = MT_FIELDCAT
                                                   IT_OUTTAB = MT_INT_CBINST ).

    MO_GRID->SET_READY_FOR_INPUT( EXPORTING I_READY_FOR_INPUT = 1 ).
    "Handle enter event
    MO_GRID->REGISTER_EDIT_EVENT( EXPORTING I_EVENT_ID = CL_GUI_ALV_GRID=>MC_EVT_ENTER ).
    SET HANDLER ME->HANDLE_DATA_CHANGED FOR MO_GRID.
    SET HANDLER ME->HANDLE_DATA_CHANGED_FINISHED FOR MO_GRID.
    "Method inside handler to set modification
    MV_CHANGED_METHOD = 'SET_MODIF_TO_INT_CBINST'.
    MV_CHANGED_FINISHED_METHOD = 'SET_FINISH_TO_INT_CBINST'.
    MV_SAVE_METHOD = 'SAVE_INT_CBINST'.
    MV_CHECK_MODIFIED_METHOD = 'CHECK_MODIFIED_INT_CBINST'.
    MV_TABLE_NAME = 'YTFM_INT_CBINST'.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00G ----
  METHOD READ_INT_CBINST_FROM_DB.

    CHECK MT_PERIOD IS NOT INITIAL.

    SELECT * FROM YTFM_INT_CBINST FOR ALL ENTRIES IN @MT_PERIOD WHERE IYEAR = @MT_PERIOD-GJAHR
                                                                AND   IMONTH = @MT_PERIOD-MONTH
                                  INTO TABLE @MT_INT_CBINST.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00H ----
  METHOD SET_MODIF_TO_INT_CBINST.

    TYPES LTTY_INT_CBINST TYPE TABLE OF YTFM_INT_CBINST.
    FIELD-SYMBOLS <LT_MODIFIED> TYPE LTTY_INT_CBINST.

    ASSIGN ER_DATA_CHANGED->MP_MOD_ROWS->* TO <LT_MODIFIED>.

    LOOP AT ER_DATA_CHANGED->MT_GOOD_CELLS INTO DATA(LS_GOOD_CELLS).
      "Check empty values
      CASE LS_GOOD_CELLS-FIELDNAME.
        WHEN 'IYEAR' OR 'IMONTH' OR 'INSTITUTE'.
          IF LS_GOOD_CELLS-VALUE IS INITIAL OR LS_GOOD_CELLS-VALUE CO '0 '.
            CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
              EXPORTING
                I_MSGID     = 'YFM1'
                I_MSGNO     = '027'
                I_MSGTY     = 'E'
                I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
            MV_ERROR = ABAP_TRUE.
          ENDIF.
      ENDCASE.
      "Check periods
      IF LS_GOOD_CELLS-FIELDNAME = 'IYEAR' OR LS_GOOD_CELLS-FIELDNAME = 'IMONTH'.
        "Get corresponing full row
        READ TABLE <LT_MODIFIED> INTO DATA(LS_MODIFIED) INDEX LS_GOOD_CELLS-TABIX.
        IF SY-SUBRC = 0.
          READ TABLE MT_PERIOD TRANSPORTING NO FIELDS WITH KEY GJAHR = LS_MODIFIED-IYEAR
                                                               MONTH = LS_MODIFIED-IMONTH.
          IF SY-SUBRC <> 0.
            CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
              EXPORTING
                I_MSGID     = 'YFM1'
                I_MSGNO     = '028'
                I_MSGTY     = 'E'
                I_MSGV1     = LS_MODIFIED-IYEAR
                I_MSGV2     = LS_MODIFIED-IMONTH
                I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
            MV_ERROR = ABAP_TRUE.
          ENDIF.
        ENDIF.
      ENDIF.
      "Check institute is without G/L account
      IF LS_GOOD_CELLS-FIELDNAME = 'INSTITUTE'.
        SELECT SINGLE * FROM YTFI_INST_INT WHERE INSTITUTE = @LS_GOOD_CELLS-VALUE
                                           AND   HKONT <> @SPACE
                        INTO @DATA(LS_DUMMY).
        IF SY-SUBRC = 0.
          CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
            EXPORTING
              I_MSGID     = 'YFM1'
              I_MSGNO     = '030'
              I_MSGTY     = 'E'
              I_MSGV1     = LS_MODIFIED-INSTITUTE
              I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
              I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
          MV_ERROR = ABAP_TRUE.
        ENDIF.
      ENDIF.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00I ----
  METHOD SET_FINISH_TO_INT_CBINST.

    DATA LV_FIRST TYPE XFELD.
    DATA LS_PREV TYPE YTFM_INT_CBINST.

    LOOP AT MT_INT_CBINST ASSIGNING FIELD-SYMBOL(<LS_INT_CBINST>).
      <LS_INT_CBINST>-MANDT = SY-MANDT.
      IF <LS_INT_CBINST>-WAERS IS INITIAL.
        <LS_INT_CBINST>-WAERS = C_USD.
      ENDIF.
    ENDLOOP.

    SORT MT_INT_CBINST.

    MV_ERROR = ABAP_FALSE.

    LOOP AT MT_INT_CBINST INTO DATA(LS_INT_CBINST).
      LV_FIRST = ABAP_FALSE.
      AT FIRST.
        LV_FIRST = ABAP_TRUE.
      ENDAT.
      IF LV_FIRST = ABAP_FALSE.
        IF LS_INT_CBINST-IYEAR = LS_PREV-IYEAR AND LS_INT_CBINST-IMONTH = LS_PREV-IMONTH AND LS_INT_CBINST-INSTITUTE = LS_PREV-INSTITUTE.
          MESSAGE I029(YFM1).
          MV_ERROR = ABAP_TRUE.
          EXIT.
        ENDIF.
      ENDIF.
      LS_PREV = LS_INT_CBINST.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00J ----
  METHOD SAVE_INT_CBINST.

    DATA LT_INSERT TYPE TABLE OF YTFM_INT_CBINST.
    DATA LT_UPDATE TYPE TABLE OF YTFM_INT_CBINST.
    DATA LV_TABIX TYPE SY-TABIX.
    DATA LV_SUBRC_UPDATE TYPE SY-SUBRC.
    DATA LV_SUBRC_INSERT TYPE SY-SUBRC.
    DATA LV_SUBRC_DELETE TYPE SY-SUBRC.

    IF MT_INT_CBINST = MT_INT_CBINST_O.
      MESSAGE 'No data to update' TYPE 'I'.
      EXIT.
    ENDIF.

    "Delete initial line from original
    DELETE MT_INT_CBINST_O WHERE INSTITUTE IS INITIAL.

    LOOP AT MT_INT_CBINST INTO DATA(LS_NEW).
      CHECK LS_NEW <> MS_INT_CBINST_DEFAULT.
      READ TABLE MT_INT_CBINST_O INTO DATA(LS_OLD) WITH KEY IYEAR = LS_NEW-IYEAR
                                                            IMONTH = LS_NEW-IMONTH
                                                            INSTITUTE = LS_NEW-INSTITUTE.
      IF SY-SUBRC = 0.
        LV_TABIX = SY-TABIX.
        IF LS_NEW-CASH_BAL <> LS_OLD-CASH_BAL OR LS_NEW-WAERS <> LS_OLD-WAERS.
          LS_NEW-MUNAM = SY-UNAME.
          LS_NEW-MDATE = SY-DATUM.
          APPEND LS_NEW TO LT_UPDATE.
        ENDIF.
        DELETE MT_INT_CBINST_O INDEX LV_TABIX.
      ELSE.
        LS_NEW-CUNAM = SY-UNAME.
        LS_NEW-CDATE = SY-DATUM.
        APPEND LS_NEW TO LT_INSERT.
      ENDIF.
    ENDLOOP.

    "Update database
    "First delete entries not in new picture
    IF MT_INT_CBINST_O IS NOT INITIAL.
      DELETE YTFM_INT_CBINST FROM TABLE MT_INT_CBINST_O.
      LV_SUBRC_DELETE = SY-SUBRC.
    ENDIF.

    "Then update entries
    IF LT_UPDATE IS NOT INITIAL.
      UPDATE YTFM_INT_CBINST FROM TABLE LT_UPDATE.
      LV_SUBRC_UPDATE = SY-SUBRC.
    ENDIF.

    "And insert entries
    IF LT_INSERT IS NOT INITIAL.
      INSERT YTFM_INT_CBINST FROM TABLE LT_INSERT.
      LV_SUBRC_INSERT = SY-SUBRC.
    ENDIF.

    IF LV_SUBRC_DELETE = 0 AND LV_SUBRC_UPDATE = 0 AND LV_SUBRC_INSERT = 0.
      COMMIT WORK.
      MT_INT_CBINST_O = MT_INT_CBINST.
      MESSAGE 'Data saved' TYPE 'S'.
    ELSE.
      ROLLBACK WORK.
      MESSAGE 'Error during save' TYPE 'I'.
    ENDIF.

  ENDMETHOD.

