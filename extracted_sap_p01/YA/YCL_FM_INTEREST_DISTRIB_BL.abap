* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00M ----
  METHOD READ_INT_PROJS_FROM_DB.

    CHECK MT_PERIOD IS NOT INITIAL.

    SELECT * FROM YTFM_INT_PROJS FOR ALL ENTRIES IN @MT_PERIOD WHERE IYEAR = @MT_PERIOD-GJAHR
                                                               AND   IMONTH = @MT_PERIOD-MONTH
                                 INTO TABLE @MT_INT_PROJS.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00N ----
  METHOD SET_MODIF_TO_INT_PROJS.

    TYPES LTTY_INT_PROJS TYPE TABLE OF YTFM_INT_PROJS.
    FIELD-SYMBOLS <LT_MODIFIED> TYPE LTTY_INT_PROJS.

    ASSIGN ER_DATA_CHANGED->MP_MOD_ROWS->* TO <LT_MODIFIED>.

    LOOP AT ER_DATA_CHANGED->MT_GOOD_CELLS INTO DATA(LS_GOOD_CELLS).
      "Check empty values
      CASE LS_GOOD_CELLS-FIELDNAME.
        WHEN 'IYEAR' OR 'IMONTH' OR 'PSPNR'.
          IF LS_GOOD_CELLS-VALUE IS INITIAL OR LS_GOOD_CELLS-VALUE CO '0 '.
            CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
              EXPORTING
                I_MSGID     = 'YFM1'
                I_MSGNO     = '027'
                I_MSGTY     = 'E'
                I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
            MV_ERROR = ABAP_TRUE.
          ENDIF.
      ENDCASE.
      "Check periods
      IF LS_GOOD_CELLS-FIELDNAME = 'IYEAR' OR LS_GOOD_CELLS-FIELDNAME = 'IMONTH'.
        "Get corresponing full row
        READ TABLE <LT_MODIFIED> INTO DATA(LS_MODIFIED) INDEX LS_GOOD_CELLS-TABIX.
        IF SY-SUBRC = 0.
          READ TABLE MT_PERIOD TRANSPORTING NO FIELDS WITH KEY GJAHR = LS_MODIFIED-IYEAR
                                                               MONTH = LS_MODIFIED-IMONTH.
          IF SY-SUBRC <> 0.
            CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
              EXPORTING
                I_MSGID     = 'YFM1'
                I_MSGNO     = '028'
                I_MSGTY     = 'E'
                I_MSGV1     = LS_MODIFIED-IYEAR
                I_MSGV2     = LS_MODIFIED-IMONTH
                I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
            MV_ERROR = ABAP_TRUE.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00O ----
  METHOD SET_FINISH_TO_INT_PROJS.

    DATA LV_FIRST TYPE XFELD.
    DATA LS_PREV TYPE YTFM_INT_PROJS.

    LOOP AT MT_INT_PROJS ASSIGNING FIELD-SYMBOL(<LS_INT_PROJS>) WHERE MANDT IS INITIAL.
      <LS_INT_PROJS>-MANDT = SY-MANDT.
    ENDLOOP.

    SORT MT_INT_PROJS.

    MV_ERROR = ABAP_FALSE.

    LOOP AT MT_INT_PROJS INTO DATA(LS_INT_PROJS).
      LV_FIRST = ABAP_FALSE.
      AT FIRST.
        LV_FIRST = ABAP_TRUE.
      ENDAT.
      IF LV_FIRST = ABAP_FALSE.
        IF LS_INT_PROJS-IYEAR = LS_PREV-IYEAR AND LS_INT_PROJS-IMONTH = LS_PREV-IMONTH AND LS_INT_PROJS-PSPNR = LS_PREV-PSPNR.
          MESSAGE I029(YFM1).
          MV_ERROR = ABAP_TRUE.
          EXIT.
        ENDIF.
      ENDIF.
      LS_PREV = LS_INT_PROJS.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00P ----
  METHOD CHECK_MODIFIED_INT_PROJS.

    EV_MODIFIED = ABAP_FALSE.

    IF MT_INT_PROJS <> MT_INT_PROJS_O.
      EV_MODIFIED = ABAP_TRUE.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00Q ----
  METHOD SAVE_INT_PROJS.

    DATA LT_INSERT TYPE TABLE OF YTFM_INT_PROJS.
    DATA LT_UPDATE TYPE TABLE OF YTFM_INT_PROJS.
    DATA LV_TABIX TYPE SY-TABIX.
    DATA LV_SUBRC_UPDATE TYPE SY-SUBRC.
    DATA LV_SUBRC_INSERT TYPE SY-SUBRC.
    DATA LV_SUBRC_DELETE TYPE SY-SUBRC.

    IF MT_INT_PROJS = MT_INT_PROJS_O.
      MESSAGE 'No data to update' TYPE 'I'.
      EXIT.
    ENDIF.

    "Delete initial line from original
    DELETE MT_INT_PROJS_O WHERE PSPNR IS INITIAL.

    LOOP AT MT_INT_PROJS INTO DATA(LS_NEW).
      CHECK LS_NEW <> MS_INT_PROJS_DEFAULT.
      READ TABLE MT_INT_PROJS_O INTO DATA(LS_OLD) WITH KEY IYEAR = LS_NEW-IYEAR
                                                           IMONTH = LS_NEW-IMONTH
                                                           PSPNR = LS_NEW-PSPNR.
      IF SY-SUBRC = 0.
        LV_TABIX = SY-TABIX.
        IF LS_NEW-STATUS <> LS_OLD-STATUS.
          LS_NEW-MUNAM = SY-UNAME.
          LS_NEW-MDATE = SY-DATUM.
          APPEND LS_NEW TO LT_UPDATE.
        ENDIF.
        DELETE MT_INT_PROJS_O INDEX LV_TABIX.
      ELSE.
        LS_NEW-CUNAM = SY-UNAME.
        LS_NEW-CDATE = SY-DATUM.
        APPEND LS_NEW TO LT_INSERT.
      ENDIF.
    ENDLOOP.

    "Update database
    "First delete entries not in new picture
    IF MT_INT_PROJS_O IS NOT INITIAL.
      DELETE YTFM_INT_PROJS FROM TABLE MT_INT_PROJS_O.
      LV_SUBRC_DELETE = SY-SUBRC.
    ENDIF.

    "Then update entries
    IF LT_UPDATE IS NOT INITIAL.
      UPDATE YTFM_INT_PROJS FROM TABLE LT_UPDATE.
      LV_SUBRC_UPDATE = SY-SUBRC.
    ENDIF.

    "And insert entries
    IF LT_INSERT IS NOT INITIAL.
      INSERT YTFM_INT_PROJS FROM TABLE LT_INSERT.
      LV_SUBRC_INSERT = SY-SUBRC.
    ENDIF.

    IF LV_SUBRC_DELETE = 0 AND LV_SUBRC_UPDATE = 0 AND LV_SUBRC_INSERT = 0.
      COMMIT WORK.
      MT_INT_PROJS_O = MT_INT_PROJS.
      MESSAGE 'Data saved' TYPE 'S'.
    ELSE.
      ROLLBACK WORK.
      MESSAGE 'Error during save' TYPE 'I'.
    ENDIF.

  ENDMETHOD.

