* ---- YCL_FM_INTEREST_DISTRIB_BL====CM001 ----
  METHOD MANAGE_INTEREST_TO_DISTRIBUTE.

    DATA LS_LAYOUT TYPE LVC_S_LAYO.

    "Set default value
    MS_INT_DISTR_DEFAULT-MANDT = SY-MANDT.
    MS_INT_DISTR_DEFAULT-WAERS = C_USD.
    "Get initial data in DB
    ME->READ_INT_DISTR_FROM_DB( ).
    "Set initial line if no data
    IF MT_INT_DISTR IS INITIAL.
      APPEND MS_INT_DISTR_DEFAULT TO MT_INT_DISTR.
    ENDIF.
    "Initialize original table
    MT_INT_DISTR_O = MT_INT_DISTR.
    "Get field catalog
    ME->GET_FIELDCAT( IV_STRUCTURE = 'YTFM_INT_DISTR' ).
    "Set field properties
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'IYEAR' IV_KEY = ABAP_TRUE IV_EDIT = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'IMONTH' IV_KEY = ABAP_TRUE IV_EDIT = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'POOLING_INT' IV_EDIT = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'WAERS' IV_AUTO_VALUE = ABAP_TRUE ).

    MO_GRID->SET_TABLE_FOR_FIRST_DISPLAY( EXPORTING IT_TOOLBAR_EXCLUDING = MT_EXCLUDE_FCT
                                                    IS_LAYOUT = LS_LAYOUT
                                          CHANGING IT_FIELDCATALOG = MT_FIELDCAT
                                                   IT_OUTTAB = MT_INT_DISTR ).

    MO_GRID->SET_READY_FOR_INPUT( EXPORTING I_READY_FOR_INPUT = 1 ).
    "Handle enter event
    MO_GRID->REGISTER_EDIT_EVENT( EXPORTING I_EVENT_ID = CL_GUI_ALV_GRID=>MC_EVT_ENTER ).
    "mo_grid->register_edit_event( EXPORTING i_event_id = cl_gui_alv_grid=>mc_evt_modified ).
    SET HANDLER ME->HANDLE_DATA_CHANGED FOR MO_GRID.
    SET HANDLER ME->HANDLE_DATA_CHANGED_FINISHED FOR MO_GRID.
    "Method inside handler to set modification
    MV_CHANGED_METHOD = 'SET_MODIF_TO_INT_DISTR'.
    MV_CHANGED_FINISHED_METHOD = 'SET_FINISH_TO_INT_DISTR'.
    MV_SAVE_METHOD = 'SAVE_INT_DISTR'.
    MV_CHECK_MODIFIED_METHOD = 'CHECK_MODIFIED_INT_DISTR'.
    MV_TABLE_NAME = 'YTFM_INT_DISTR'.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM002 ----
  METHOD FILL_PERIODS.

    DATA LT_PERIOD TYPE TTY_PERIOD.
    DATA LV_QUARTER TYPE YE_CA_QUARTER.

    MV_YEAR = IV_YEAR.
    MV_QUARTER = IV_QUARTER_TO.

    CLEAR MT_PERIOD.
    LV_QUARTER = IV_QUARTER_FROM.

    DO.
      GET_QUARTER_PERIOD( EXPORTING IV_GJAHR = IV_YEAR
                                    IV_QUARTER = LV_QUARTER
                          IMPORTING ET_PERIOD = LT_PERIOD ).
      APPEND LINES OF LT_PERIOD TO MT_PERIOD.
      ADD 1 TO LV_QUARTER.
      IF IV_QUARTER_TO IS INITIAL OR IV_QUARTER_TO < LV_QUARTER.
        EXIT.
      ENDIF.
    ENDDO.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM003 ----
  METHOD GET_QUARTER_PERIOD.

    DATA LS_PERIOD TYPE TY_PERIOD.

    CLEAR: ET_PERIOD, EV_TEXT.

    CASE IV_QUARTER.
      WHEN '1'.
        LS_PERIOD-GJAHR = IV_GJAHR - 1.
        LS_PERIOD-MONTH = 12.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
        LS_PERIOD-GJAHR = IV_GJAHR.
        LS_PERIOD-MONTH = 1.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
        LS_PERIOD-MONTH = 2.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
      WHEN '2'.
        LS_PERIOD-GJAHR = IV_GJAHR.
        LS_PERIOD-MONTH = 3.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
        LS_PERIOD-MONTH = 4.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
        LS_PERIOD-MONTH = 5.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
      WHEN '3'.
        LS_PERIOD-GJAHR = IV_GJAHR.
        LS_PERIOD-MONTH = 6.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
        LS_PERIOD-MONTH = 7.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
        LS_PERIOD-MONTH = 8.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
      WHEN '4'.
        LS_PERIOD-GJAHR = IV_GJAHR.
        LS_PERIOD-MONTH = 9.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
        LS_PERIOD-MONTH = 10.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
        LS_PERIOD-MONTH = 11.
        LS_PERIOD-MTEXT = YCL_CA_UTILITIES=>GET_MONTH_NAME( EXPORTING IV_MONTH = LS_PERIOD-MONTH ).
        APPEND LS_PERIOD TO ET_PERIOD.
    ENDCASE.

    "IF ev_text IS SUPPLIED.
    READ TABLE ET_PERIOD INTO LS_PERIOD INDEX 1.
    EV_TEXT = |{ LS_PERIOD-MTEXT } { LS_PERIOD-GJAHR } -|.
    READ TABLE ET_PERIOD INTO LS_PERIOD INDEX 3.
    EV_TEXT = |{ EV_TEXT } { LS_PERIOD-MTEXT } { LS_PERIOD-GJAHR }|.
    "ENDIF.

  ENDMETHOD.

