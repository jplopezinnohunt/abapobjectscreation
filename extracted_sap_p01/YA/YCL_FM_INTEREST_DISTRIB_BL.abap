* ---- YCL_FM_INTEREST_DISTRIB_BL====CM012 ----
  METHOD GET_CONSOLIDATED_AMOUNTS.

    DATA LV_PERIOD(6) TYPE N.

    CLEAR: EV_PROPORTION, EV_INT_TO_DISTRIB, EV_INT_DISTRIBUTED, EV_MCA_CREDIT.

    IF IV_CASH_BAL_TOTAL IS NOT INITIAL AND IV_CASH_BAL > 0.
      "Proportion
      EV_PROPORTION = IV_CASH_BAL * 100 / IV_CASH_BAL_TOTAL.
      "Interest to distribute
      EV_INT_TO_DISTRIB = IV_INTEREST_PULLING * EV_PROPORTION / 100.
    ENDIF.

    """""Determine if Interest distributed on project or on MCA credit
    IF IV_FINCODE IS INITIAL.
      "Institute => on project
      EV_INT_DISTRIBUTED = EV_INT_TO_DISTRIB.
      EXIT.
    ENDIF.

    IF IV_CASH_BAL <= 50000 OR IV_INT_PROJ_STATUS = C_PRE_CLOSED.
      "Cash balance is lower or equal to 50000$ or project pre-closed => on MCA credit
      EV_MCA_CREDIT = EV_INT_TO_DISTRIB.
      EXIT.
    ENDIF.

    IF IV_DATBIS <= MV_ENDDA.
      "Fund ending before end of quarter: =>go to MCA
      EV_MCA_CREDIT = EV_INT_TO_DISTRIB.
      EXIT.
    ENDIF.

    "It depends of factor
    CASE IV_FACTOR.
      WHEN 0.
        EV_MCA_CREDIT = EV_INT_TO_DISTRIB.
      WHEN 1.
        EV_INT_DISTRIBUTED = EV_INT_TO_DISTRIB.
      WHEN OTHERS.
        EV_INT_DISTRIBUTED = EV_INT_TO_DISTRIB * IV_FACTOR.
        EV_MCA_CREDIT = EV_INT_TO_DISTRIB - EV_INT_DISTRIBUTED.
    ENDCASE.


  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM013 ----
  METHOD GET_DATA.

    MV_FIKRS = IV_FIKRS.
    MV_BUKRS = IV_BUKRS.

    CHECK MT_PERIOD IS NOT INITIAL.

    "Get currency from company code
    SELECT SINGLE WAERS FROM T001 WHERE BUKRS = @IV_BUKRS INTO @MV_CURRENCY.

    "Get start date and end date of full period
    READ TABLE MT_PERIOD INTO DATA(LS_PERIOD) INDEX 1.
    MV_BEGDA = |{ LS_PERIOD-GJAHR }{ LS_PERIOD-MONTH }01|.
    READ TABLE MT_PERIOD INTO LS_PERIOD INDEX 3.
    MV_ENDDA = |{ LS_PERIOD-GJAHR }{ LS_PERIOD-MONTH }01|.
    MV_ENDDA = YCL_CA_UTILITIES=>GET_LAST_DAY_OF_MONTH( IV_DATE = MV_ENDDA ).

    "Get data from specific tables
    ME->READ_INT_DISTR_FROM_DB( ).
    ME->READ_INT_CBINST_FROM_DB( ).
    ME->READ_INT_DEDU_FROM_DB( ).
    ME->READ_INT_PROJS_FROM_DB_REPORT( IV_PERIOD_TO = LS_PERIOD ).
    ME->READ_INT_SUBST_FROM_DB( IV_BEGDA = MV_BEGDA
                                IV_ENDDA = MV_ENDDA
                                IV_REPLACE_STAR = ABAP_TRUE ).
    ME->READ_INSTITUTES_FROM_DB( ).

    "Get valid project from funds
    ME->READ_PROJECT_FROM_DB( IT_FUND = IT_FUND
                              IT_GSBER = IT_GSBER
                              IV_EXCL_CLOSED = IV_EXCL_CLOSED
                              IV_EXCL_UNDP = IV_EXCL_UNDP
                              IV_BEGDA = IV_BEGDA ).

    "Get fund which go to MCA independently of rules
    ME->READ_MCA_FUND( IT_FUND = IT_MCA_FUND ).

    IF MT_FUND IS NOT INITIAL.
      "Get cash balance data
      ME->READ_FMIT( IT_WRTTP = IT_WRTTP
                     IT_GSBER = IT_GSBER ).
    ENDIF.

    "Get data for institutes
    LOOP AT MT_INST ASSIGNING FIELD-SYMBOL(<LS_INST>).
      "Check if G/L account for institute
      LOOP AT MT_INST_INT INTO DATA(LS_INST_INT) WHERE INSTITUTE = <LS_INST>-INSTITUTE
                                                 AND   HKONT <> SPACE.
        EXIT.
      ENDLOOP.
      IF SY-SUBRC = 0.
        <LS_INST>-WITH_GL = ABAP_TRUE.
        <LS_INST>-INSTITUTE_TEXT = |{ LS_INST_INT-INSTITUTE } - { LS_INST_INT-HKONT }|.
        ME->READ_GLT0( IV_INSTITUTE = <LS_INST>-INSTITUTE ).
      ELSE.  "No G/L account
        <LS_INST>-INSTITUTE_TEXT = <LS_INST>-INSTITUTE.
      ENDIF.
    ENDLOOP.

    SORT MT_INST BY WITH_GL DESCENDING INSTITUTE ASCENDING.

    SORT MT_GLT0.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM014 ----
  METHOD GET_FACTOR.

    IF IV_FINCODE IS NOT INITIAL.
      "Check if exception from selection screen
      READ TABLE MT_MCA_FUND TRANSPORTING NO FIELDS WITH KEY FIKRS = MV_FIKRS
                                                             FINCODE = IV_FINCODE.
      IF SY-SUBRC = 0.
        RV_FACTOR = 0.
        EXIT.
      ENDIF.
      "Check if project is closed
      READ TABLE MT_PROJECT INTO DATA(LS_PROJECT) WITH KEY FIKRS = MV_FIKRS
                                                           FINCODE = IV_FINCODE.
      IF SY-SUBRC = 0 AND LS_PROJECT-STATUS = 'CLSD'.
        RV_FACTOR = 0.
        EXIT.
      ENDIF.
    ENDIF.

    CASE IV_RETENTION_RULE.
      WHEN 'N' OR SPACE.
        RV_FACTOR = 1.
      WHEN '2/3' OR 'Err'.
        RV_FACTOR = '0.67'.
      WHEN OTHERS.
        RV_FACTOR = 0.
    ENDCASE.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM015 ----
  METHOD GET_FMIT_AMOUNT.

    DATA LV_FIELDNAME TYPE FIELDNAME.
    DATA LV_PER TYPE YE_PERIOD.
    DATA LV_PER_MAX TYPE YE_PERIOD.
    DATA LV_NUM(2) TYPE N.
    FIELD-SYMBOLS <FIELD> TYPE ANY.

    CLEAR RV_AMOUNT.

    IF IV_INDEX = 1.
      IF IV_MONTH = 12.
        LV_PER_MAX = |{ IV_YEAR }16|.
      ELSE.
        LV_PER_MAX = |{ IV_YEAR }{ IV_MONTH }|.
      ENDIF.
      LOOP AT MT_FMIT INTO DATA(LS_FMIT) WHERE FIKRS = IV_FIKRS
                                         AND   FINCODE = IV_FINCODE
                                         AND   RYEAR <= IV_YEAR.
        CLEAR LV_NUM.
        DO 16 TIMES.
          ADD 1 TO LV_NUM.
          LV_PER = |{ LS_FMIT-RYEAR }{ LV_NUM }|.
          IF LV_PER > LV_PER_MAX.
            EXIT.
          ENDIF.
          LV_FIELDNAME = |LS_FMIT-HSL{ LV_NUM }|.
          ASSIGN (LV_FIELDNAME) TO <FIELD>.
          ADD <FIELD> TO RV_AMOUNT.
        ENDDO.
      ENDLOOP.

    ELSEIF IV_MONTH = 12.
      LOOP AT MT_FMIT INTO LS_FMIT WHERE FIKRS = IV_FIKRS
                                   AND   FINCODE = IV_FINCODE
                                   AND   RYEAR = IV_YEAR.
        LV_NUM = 11.
        DO 5 TIMES.
          ADD 1 TO LV_NUM.
          LV_PER = |{ LS_FMIT-RYEAR }{ LV_NUM }|.
          LV_FIELDNAME = |LS_FMIT-HSL{ LV_NUM }|.
          ASSIGN (LV_FIELDNAME) TO <FIELD>.
          ADD <FIELD> TO RV_AMOUNT.
        ENDDO.
      ENDLOOP.

    ELSE.
      LV_FIELDNAME = |LS_FMIT-HSL{ IV_MONTH }|.
      LOOP AT MT_FMIT INTO LS_FMIT WHERE FIKRS = IV_FIKRS
                                   AND   FINCODE = IV_FINCODE
                                   AND   RYEAR = IV_YEAR.
        ASSIGN (LV_FIELDNAME) TO <FIELD>.
        ADD <FIELD> TO RV_AMOUNT.
      ENDLOOP.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM016 ----
  METHOD GET_GLT0_AMOUNT.

    DATA LV_FIELDNAME TYPE FIELDNAME.
    FIELD-SYMBOLS <FIELD> TYPE ANY.
    DATA LV_MONTH(2) TYPE N.

    CLEAR RV_AMOUNT.

    LOOP AT MT_GLT0 INTO DATA(LS_GLT0) WHERE INSTITUTE = IV_INSTITUTE
                                       AND   RYEAR = IV_YEAR.
      "Get carry forward
      LV_FIELDNAME = 'LS_GLT0-HSLVT'.
      ASSIGN (LV_FIELDNAME) TO <FIELD>.
      MULTIPLY <FIELD> BY -1.
      ADD <FIELD> TO RV_AMOUNT.
      "Do the cumulative until the concerned month
      LV_MONTH = 1.
      DO 16 TIMES.
        IF IV_MONTH <> 12 AND LV_MONTH > IV_MONTH.
          EXIT.
        ENDIF.
        LV_FIELDNAME = |LS_GLT0-HSL{ LV_MONTH }|.
        ASSIGN (LV_FIELDNAME) TO <FIELD>.
        MULTIPLY <FIELD> BY -1.
        ADD <FIELD> TO RV_AMOUNT.
        ADD 1 TO LV_MONTH.
      ENDDO.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM017 ----
  METHOD GET_POSTING_RULE.

    IF IV_FINCODE IS INITIAL.
      READ TABLE MT_INST INTO DATA(LS_INST) WITH KEY INSTITUTE_TEXT = IV_CODE_TO_CREDIT.
      IF SY-SUBRC = 0.
        IF LS_INST-WITH_GL = ABAP_TRUE.
          RV_POSTING_RULE = 'IBC'.
        ELSE.
          RV_POSTING_RULE = 'UBC'.
        ENDIF.
      ENDIF.
    ELSE.
      RV_POSTING_RULE = 'PROJ'.
    ENDIF.

*    IF iv_int_proj_status = c_pre_closed OR iv_datbis <= mv_endda.
*      rv_posting_rule = 'MCA'.
*      EXIT.
*    ENDIF.
*
*    IF iv_cash_bal <= 50000 OR iv_retention_rule = '1' OR iv_retention_rule = 'N'.
*      rv_posting_rule = 'MCA'.
*    ELSE.
*      rv_posting_rule = 'PROJ'.
*    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM018 ----
  METHOD GET_RETENTION_RULE.

    IF IV_YYE_PRCRT IS INITIAL.
      RV_RETENTION_RULE = 'N'.       "100% goes to interest distributed
    ELSEIF IV_YYE_PRCRT BETWEEN 33 AND 34.
      RV_RETENTION_RULE = '2/3'.     "67% goes to interest distributed and 33% goes to MCA
    ELSEIF IV_YYE_PRCRT = '100.00'.
      RV_RETENTION_RULE = '1'.       "100% goes to MCA
    ELSE.
      RV_RETENTION_RULE = 'Err'.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM019 ----
