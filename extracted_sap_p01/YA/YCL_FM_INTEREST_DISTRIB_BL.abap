    MV_CHECK_MODIFIED_METHOD = 'CHECK_MODIFIED_INT_SUBST'.
    MV_TABLE_NAME = 'YTFM_INT_SUBST'.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01A ----
  METHOD PREPARE_DATA_FOR_CONSOLID_LIST.

    DATA LS_HEADER_PULLING LIKE LINE OF MT_HEADER.
    DATA LS_HEADER_DISTRIBUTED LIKE LINE OF MT_HEADER.
    DATA LS_HEADER_MCA_CREDIT LIKE LINE OF MT_HEADER.
    DATA LV_INDEX(1) TYPE N.
    DATA LV_FIELDNAME TYPE TEXT50.
    FIELD-SYMBOLS <FIELD> TYPE ANY.
    DATA LS_LIST_CON TYPE YSFM_INT_REP2.
    DATA LS_COLOR TYPE LVC_S_SCOL.

    MV_FUND_MCA_POSTING = IV_FUND_MCA_POSTING.

    "Get detailed data
    ME->PREPARE_DATA_FOR_DETAILED_LIST( ).

    "Free memory
    CLEAR MT_LIST_DET_I.

    "Get total cash balance header
    READ TABLE MT_HEADER INTO DATA(LS_HEADER_CASH_BAL) INDEX 4.

    "Set interest to distribute in header table
    LOOP AT MT_PERIOD INTO DATA(LS_PERIOD).
      ADD 1 TO LV_INDEX.
      LS_HEADER_PULLING-AMOUNT_TYPE = 'Interest Pulling'.
      LV_FIELDNAME = |LS_HEADER_PULLING-AMOUNT_MONTH_{ LV_INDEX }|.
      ASSIGN (LV_FIELDNAME) TO <FIELD>.
      READ TABLE MT_INT_DISTR INTO DATA(LS_DISTR) WITH KEY IYEAR = LS_PERIOD-GJAHR
                                                           IMONTH = LS_PERIOD-MONTH.
      IF SY-SUBRC = 0.
        <FIELD> = LS_DISTR-POOLING_INT.
        LS_HEADER_PULLING-WAERS = LS_DISTR-WAERS.
        ADD LS_DISTR-POOLING_INT TO LS_HEADER_PULLING-AMOUNT_QUARTER.
      ELSE.
        <FIELD> = 0.
        LS_HEADER_PULLING-WAERS = MV_CURRENCY.
      ENDIF.
    ENDLOOP.
    LS_COLOR-COLOR-INT = 1.
    LS_COLOR-COLOR-COL = COL_TOTAL.
    LS_COLOR-FNAME = 'AMOUNT_QUARTER'.
    APPEND LS_COLOR TO LS_HEADER_PULLING-COLFIELD.
    APPEND LS_HEADER_PULLING TO MT_HEADER.

    "Prepare header for interest distributed
    LS_HEADER_DISTRIBUTED-AMOUNT_TYPE = 'Interest distributed'.
    LS_HEADER_DISTRIBUTED-WAERS = MV_CURRENCY.

    "Prepare header for MCA credit
    LS_HEADER_MCA_CREDIT-AMOUNT_TYPE = C_MCA_CREDIT.
    LS_HEADER_MCA_CREDIT-WAERS = MV_CURRENCY.

    LOOP AT MT_LIST_PRE_I INTO DATA(LS_LIST_PRE).

      "If negative values for a month, don't take it
      IF LS_LIST_PRE-CASH_BAL_M1 < 0.
        LS_LIST_PRE-CASH_BAL_M1 = 0.
      ENDIF.
      IF LS_LIST_PRE-CASH_BAL_M2 < 0.
        LS_LIST_PRE-CASH_BAL_M2 = 0.
      ENDIF.
      IF LS_LIST_PRE-CASH_BAL_M3 < 0.
        LS_LIST_PRE-CASH_BAL_M3 = 0.
      ENDIF.

      "Exclude zero cash balances
      IF LS_LIST_PRE-CASH_BAL_M1 = 0 AND LS_LIST_PRE-CASH_BAL_M2 = 0 AND LS_LIST_PRE-CASH_BAL_M3 = 0.
        CONTINUE.
      ENDIF.

      CLEAR LS_LIST_CON.
      MOVE-CORRESPONDING LS_LIST_PRE TO LS_LIST_CON.
      LS_LIST_CON-FACTOR = ME->GET_FACTOR( IV_FINCODE = LS_LIST_PRE-FINCODE
                                           IV_RETENTION_RULE = LS_LIST_PRE-RETENTION_RULE ).
      LS_LIST_CON-POSTING_RULE = ME->GET_POSTING_RULE( IV_FINCODE = LS_LIST_PRE-FINCODE
                                                       IV_CODE_TO_CREDIT = LS_LIST_PRE-CODE_TO_CREDIT ).
      "Month 1
      ME->GET_CONSOLIDATED_AMOUNTS( EXPORTING IV_FINCODE = LS_LIST_PRE-FINCODE
                                              IV_DATBIS = LS_LIST_PRE-DATBIS
                                              IV_INT_PROJ_STATUS = LS_LIST_PRE-INT_PROJ_STATUS
                                              IV_FACTOR = LS_LIST_CON-FACTOR
                                              IV_CASH_BAL = LS_LIST_CON-CASH_BAL_M1
                                              IV_CASH_BAL_TOTAL = LS_HEADER_CASH_BAL-AMOUNT_MONTH_1
                                              IV_INTEREST_PULLING = LS_HEADER_PULLING-AMOUNT_MONTH_1
                                              IV_MONTH_INDEX = 1
                                    IMPORTING EV_PROPORTION = LS_LIST_CON-PROPORTION_M1
                                              EV_INT_TO_DISTRIB = LS_LIST_CON-INT_TO_DISTR_M1
                                              EV_INT_DISTRIBUTED = LS_LIST_CON-INT_DISTRIB_M1
                                              EV_MCA_CREDIT = LS_LIST_CON-MCA_CREDIT_M1 ).
      "Set to total columns
      ADD LS_LIST_CON-INT_DISTRIB_M1 TO LS_LIST_CON-INT_DISTRIB_QUARTER.
      ADD LS_LIST_CON-MCA_CREDIT_M1 TO LS_LIST_CON-MCA_CREDIT_QUARTER.
      "Set to header table
      ADD LS_LIST_CON-INT_DISTRIB_M1 TO LS_HEADER_DISTRIBUTED-AMOUNT_MONTH_1.
      ADD LS_LIST_CON-MCA_CREDIT_M1 TO LS_HEADER_MCA_CREDIT-AMOUNT_MONTH_1.

      "Month 2
      ME->GET_CONSOLIDATED_AMOUNTS( EXPORTING IV_FINCODE = LS_LIST_PRE-FINCODE
                                              IV_DATBIS = LS_LIST_PRE-DATBIS
                                              IV_INT_PROJ_STATUS = LS_LIST_PRE-INT_PROJ_STATUS
                                              IV_FACTOR = LS_LIST_CON-FACTOR
                                              IV_CASH_BAL = LS_LIST_CON-CASH_BAL_M2
                                              IV_CASH_BAL_TOTAL = LS_HEADER_CASH_BAL-AMOUNT_MONTH_2
                                              IV_INTEREST_PULLING = LS_HEADER_PULLING-AMOUNT_MONTH_2
                                              IV_MONTH_INDEX = 2
                                    IMPORTING EV_PROPORTION = LS_LIST_CON-PROPORTION_M2
                                              EV_INT_TO_DISTRIB = LS_LIST_CON-INT_TO_DISTR_M2
                                              EV_INT_DISTRIBUTED = LS_LIST_CON-INT_DISTRIB_M2
                                              EV_MCA_CREDIT = LS_LIST_CON-MCA_CREDIT_M2 ).
      "Set to total columns
      ADD LS_LIST_CON-INT_DISTRIB_M2 TO LS_LIST_CON-INT_DISTRIB_QUARTER.
      ADD LS_LIST_CON-MCA_CREDIT_M2 TO LS_LIST_CON-MCA_CREDIT_QUARTER.
      "Set to header table
      ADD LS_LIST_CON-INT_DISTRIB_M2 TO LS_HEADER_DISTRIBUTED-AMOUNT_MONTH_2.
      ADD LS_LIST_CON-MCA_CREDIT_M2 TO LS_HEADER_MCA_CREDIT-AMOUNT_MONTH_2.

      "Month 3
      ME->GET_CONSOLIDATED_AMOUNTS( EXPORTING IV_FINCODE = LS_LIST_PRE-FINCODE
                                              IV_DATBIS = LS_LIST_PRE-DATBIS
                                              IV_INT_PROJ_STATUS = LS_LIST_PRE-INT_PROJ_STATUS
                                              IV_FACTOR = LS_LIST_CON-FACTOR
                                              IV_CASH_BAL = LS_LIST_CON-CASH_BAL_M3
                                              IV_CASH_BAL_TOTAL = LS_HEADER_CASH_BAL-AMOUNT_MONTH_3
                                              IV_INTEREST_PULLING = LS_HEADER_PULLING-AMOUNT_MONTH_3
                                              IV_MONTH_INDEX = 3
                                    IMPORTING EV_PROPORTION = LS_LIST_CON-PROPORTION_M3
                                              EV_INT_TO_DISTRIB = LS_LIST_CON-INT_TO_DISTR_M3
                                              EV_INT_DISTRIBUTED = LS_LIST_CON-INT_DISTRIB_M3
                                              EV_MCA_CREDIT = LS_LIST_CON-MCA_CREDIT_M3 ).
      "Set to total columns
      ADD LS_LIST_CON-INT_DISTRIB_M3 TO LS_LIST_CON-INT_DISTRIB_QUARTER.
      ADD LS_LIST_CON-MCA_CREDIT_M3 TO LS_LIST_CON-MCA_CREDIT_QUARTER.
      "Set to header table
      ADD LS_LIST_CON-INT_DISTRIB_M3 TO LS_HEADER_DISTRIBUTED-AMOUNT_MONTH_3.
      ADD LS_LIST_CON-MCA_CREDIT_M3 TO LS_HEADER_MCA_CREDIT-AMOUNT_MONTH_3.

      "Set posting check status for fund
      IF LS_LIST_PRE-FINCODE IS NOT INITIAL.
        READ TABLE MT_MCA_FUND TRANSPORTING NO FIELDS WITH KEY FIKRS = MV_FIKRS
                                                               FINCODE = LS_LIST_PRE-FINCODE.
        IF SY-SUBRC = 0.
          WRITE ICON_INCOMING_EMPLOYEE TO LS_LIST_CON-POSTING_CHECK AS ICON.
        ELSE.
          "Check if project is closed (after the beginning of the quarter)
          READ TABLE MT_PROJECT INTO DATA(LS_PROJECT) WITH KEY FIKRS = MV_FIKRS
                                                               FINCODE = LS_LIST_PRE-FINCODE.
          IF SY-SUBRC = 0 AND LS_PROJECT-STATUS = 'CLSD'.
            WRITE ICON_CLOSE TO LS_LIST_CON-POSTING_CHECK AS ICON.
          ELSEIF LS_LIST_PRE-INT_PROJ_STATUS = C_PRE_CLOSED.   "Pre-closed
            WRITE ICON_LED_YELLOW TO LS_LIST_CON-POSTING_CHECK AS ICON.
          ELSE.
            IF LS_LIST_CON-POSTING_RULE <> 'PROJ'.
              WRITE ICON_LED_GREEN TO LS_LIST_CON-POSTING_CHECK AS ICON.
            ELSE.   "PROJ
              IF LS_LIST_PRE-DATBIS < MV_BEGDA.
                WRITE ICON_LED_RED TO LS_LIST_CON-POSTING_CHECK AS ICON.
              ELSEIF LS_LIST_PRE-DATBIS >= MV_ENDDA.
                WRITE ICON_LED_GREEN TO LS_LIST_CON-POSTING_CHECK AS ICON.
              ELSE.
                IF ME->CHECK_BAL_EXISTS_AFTER_DATE( IS_DATA = LS_LIST_PRE ) = ABAP_TRUE.   "cash bal exists from fund end date
                  WRITE ICON_MESSAGE_WARNING TO LS_LIST_CON-POSTING_CHECK AS ICON.
                ELSE.
                  WRITE ICON_LED_GREEN TO LS_LIST_CON-POSTING_CHECK AS ICON.
                ENDIF.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.

      "Do quarter interest ditributed rounding
      ME->DO_ROUNDING_DISTRIBUTION( CHANGING CV_INT_DISTRIB = LS_LIST_CON-INT_DISTRIB_QUARTER
                                             CV_MCA_CREDIT = LS_LIST_CON-MCA_CREDIT_QUARTER ).

      APPEND LS_LIST_CON TO MT_LIST_CON_I.

      "Add to header quarter amounts
      ADD LS_LIST_CON-INT_DISTRIB_QUARTER TO LS_HEADER_DISTRIBUTED-AMOUNT_QUARTER.
      ADD LS_LIST_CON-MCA_CREDIT_QUARTER TO LS_HEADER_MCA_CREDIT-AMOUNT_QUARTER.

    ENDLOOP.

    "Set TOTAL to header table
    "ls_header_distributed-amount_quarter = ls_header_distributed-amount_month_1 + ls_header_distributed-amount_month_2 + ls_header_distributed-amount_month_3.
    LS_COLOR-COLOR-INT = 1.
    LS_COLOR-COLOR-COL = COL_TOTAL.
    LS_COLOR-FNAME = 'AMOUNT_QUARTER'.
    APPEND LS_COLOR TO LS_HEADER_DISTRIBUTED-COLFIELD.
    APPEND LS_HEADER_DISTRIBUTED TO MT_HEADER.
    "ls_header_mca_credit-amount_quarter = ls_header_mca_credit-amount_month_1 + ls_header_mca_credit-amount_month_2 + ls_header_mca_credit-amount_month_3.
    LS_COLOR-COLOR-INT = 1.
    LS_COLOR-COLOR-COL = COL_TOTAL.
    LS_COLOR-FNAME = 'AMOUNT_QUARTER'.
    APPEND LS_COLOR TO LS_HEADER_MCA_CREDIT-COLFIELD.
    APPEND LS_HEADER_MCA_CREDIT TO MT_HEADER.

    "free memory
    CLEAR MT_LIST_PRE_I.

    "Prepare data for posting
    ME->PREPARE_DATA_FOR_POSTING( ).

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01B ----
  METHOD PREPARE_DATA_FOR_DETAILED_LIST.

    DATA LS_HEADER TYPE TY_HEADER.
    DATA LS_COLOR TYPE LVC_S_SCOL.

    "initialize header table
    CLEAR MT_HEADER.
    APPEND VALUE #( AMOUNT_TYPE = 'Fund' WAERS = MV_CURRENCY ) TO MT_HEADER.
    APPEND VALUE #( AMOUNT_TYPE = 'Institutes GL' WAERS = MV_CURRENCY ) TO MT_HEADER.
    APPEND VALUE #( AMOUNT_TYPE = 'Institutes no GL' WAERS = MV_CURRENCY ) TO MT_HEADER.

    CLEAR: MT_LIST_DET_I, MT_LIST_PRE_I.

    "Get data for project
    ME->PREPARE_PROJECT_DATA( ).

    SORT MT_LIST_DET_I BY CODE_TO_CREDIT.
    SORT MT_LIST_PRE_I BY FINCODE RETENTION_RULE.

    "Get data for institutes
    ME->PREPARE_INSTITUTE_DATA( ).

    "Group by code to credit
    ME->GROUP_BY_CODE_TO_CREDIT( ).

    "Filter data and set header
    ME->FILTER_AND_SET_HEADER_DATA( ).

    "Calculate total line for header
    CLEAR LS_HEADER.
    LS_HEADER-AMOUNT_TYPE = 'Total cash balance'.
    LS_HEADER-WAERS = MV_CURRENCY.
    LOOP AT MT_HEADER INTO DATA(LS_HEADER_DET).
      "Calculate total
      ADD LS_HEADER_DET-AMOUNT_MONTH_1 TO LS_HEADER-AMOUNT_MONTH_1.
      ADD LS_HEADER_DET-AMOUNT_MONTH_2 TO LS_HEADER-AMOUNT_MONTH_2.
      ADD LS_HEADER_DET-AMOUNT_MONTH_3 TO LS_HEADER-AMOUNT_MONTH_3.
    ENDLOOP.

    "Set total color
    LS_COLOR-COLOR-INT = 1.
    LS_COLOR-COLOR-COL = COL_TOTAL.
    LS_COLOR-FNAME = 'AMOUNT_MONTH_1'.
    APPEND LS_COLOR TO LS_HEADER-COLFIELD.
    LS_COLOR-FNAME = 'AMOUNT_MONTH_2'.
    APPEND LS_COLOR TO LS_HEADER-COLFIELD.
    LS_COLOR-FNAME = 'AMOUNT_MONTH_3'.
    APPEND LS_COLOR TO LS_HEADER-COLFIELD.
    LS_COLOR-FNAME = 'WAERS'.
    APPEND LS_COLOR TO LS_HEADER-COLFIELD.

    APPEND LS_HEADER TO MT_HEADER.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01C ----
  METHOD READ_FMIT.

    DATA LT_WRTTP TYPE RANGE OF FM_WRTTP.

    "Get highest fiscal year
    DATA(LV_LINES) = LINES( MT_PERIOD ).
    READ TABLE MT_PERIOD INTO DATA(LS_PERIOD) INDEX LV_LINES.

    IF IT_GSBER IS NOT INITIAL.
      APPEND VALUE #( SIGN = 'I' OPTION = 'EQ' LOW = SPACE ) TO IT_GSBER.   "Old values without any business area
    ENDIF.

    SELECT A~FIKRS,
           A~RFONDS AS FINCODE,
           A~RYEAR,
           A~RBUKRS AS BUKRS,
           A~HSLVT,
           A~HSL01,
           A~HSL02,
           A~HSL03,
           A~HSL04,
           A~HSL05,
           A~HSL06,
           A~HSL07,
           A~HSL08,
           A~HSL09,
           A~HSL10,
           A~HSL11,
           A~HSL12,
           A~HSL13,
           A~HSL14,
           A~HSL15,
           A~HSL16,
           A~RLDNR,
           A~RRCTY,
           A~RVERS,
           A~ROBJNR,
           A~COBJNR,
           A~SOBJNR,
           A~RTCUR,
           A~RPMAX
           FROM FMIT AS A
           FOR ALL ENTRIES IN @MT_FUND
           WHERE A~RLDNR = '9A'
           AND   A~RRCTY = '0'
           AND   A~RVERS = '000'
           AND   A~RYEAR <= @LS_PERIOD-GJAHR
           AND   A~RBUKRS = @MT_FUND-BUKRS
           AND   A~FIKRS = @MT_FUND-FIKRS
           AND   A~RFONDS = @MT_FUND-FINCODE
           AND   A~RWRTTP IN @IT_WRTTP
           AND   A~RBUSA IN @IT_GSBER
           %_HINTS MSSQLNT 'TABLE FMIT ABINDEX(3)'
           APPENDING TABLE @MT_FMIT.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01D ----
  METHOD READ_GLT0.

    DATA LT_HKONT TYPE RANGE OF HKONT.
    DATA LT_GSBER TYPE RANGE OF GSBER.
    DATA LT_GJAHR TYPE RANGE OF GJAHR.

    "Get G/accounts and business area for institute
    LOOP AT MT_INST_INT INTO DATA(LS_INST_INT) WHERE INSTITUTE = IV_INSTITUTE.
      IF LS_INST_INT-HKONT IS NOT INITIAL.
        APPEND VALUE #( SIGN = 'I' OPTION = 'EQ' LOW = LS_INST_INT-HKONT ) TO LT_HKONT.
      ENDIF.
      IF LS_INST_INT-GSBER IS NOT INITIAL.
        APPEND VALUE #( SIGN = 'I' OPTION = 'EQ' LOW = LS_INST_INT-GSBER ) TO LT_GSBER.
      ENDIF.
    ENDLOOP.

    "Get years from period
    LOOP AT MT_PERIOD INTO DATA(LS_PERIOD).
      APPEND VALUE #( SIGN = 'I' OPTION = 'EQ' LOW = LS_PERIOD-GJAHR ) TO LT_GJAHR.
    ENDLOOP.
    SORT LT_GJAHR.
    DELETE ADJACENT DUPLICATES FROM LT_GJAHR.

    "Get data from GLT0 table for balance
    SELECT @IV_INSTITUTE,
           BUKRS,
           RYEAR,
           RACCT,
           RBUSA,
           RTCUR,
           DRCRK,
           RPMAX,
           HSLVT,
           HSL01,
           HSL02,
           HSL03,
           HSL04,
           HSL05,
           HSL06,
           HSL07,
           HSL08,
           HSL09,
           HSL10,
           HSL11,
           HSL12,
           HSL13,
           HSL14,
           HSL15,
           HSL16
      FROM GLT0
      WHERE RLDNR = '00'
      AND   RRCTY = '0'
      AND   RVERS = '001'
      AND   BUKRS = @MV_BUKRS
      AND   RYEAR IN @LT_GJAHR
      AND   RACCT IN @LT_HKONT
      AND   RBUSA IN @LT_GSBER
      APPENDING TABLE @MT_GLT0.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01E ----
  METHOD READ_INSTITUTES_FROM_DB.

    "Get institutes master data
    SELECT INSTITUTE, RETENTION_RULE, BUKRS FROM YTFI_INSTITUTE INTO CORRESPONDING FIELDS OF TABLE @MT_INST.

    "Get institutes data for interest
    SELECT * FROM YTFI_INST_INT INTO TABLE @MT_INST_INT.

    "Add other entities
    SELECT DISTINCT ENTITY AS INSTITUTE, RETENTION_RULE FROM YTFI_OTHER_INT
                                                        "WHERE retention_rule <> @space
                    APPENDING CORRESPONDING FIELDS OF TABLE @MT_INST.

    SELECT MANDT, ENTITY AS INSTITUTE, SEQNR, GSBER, HKONT, FINCODE, FISTL, KOSTL FROM YTFI_OTHER_INT
           APPENDING CORRESPONDING FIELDS OF TABLE @MT_INST_INT.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01F ----
  METHOD READ_INT_SUBST_FROM_DB.

    DATA LT_SUBST TYPE TABLE OF YSFM_INT_SUBST.
    DATA LT_FUND TYPE TABLE OF BP_GEBER.

    CLEAR MT_SUBST.

    IF IV_BEGDA IS INITIAL AND IV_ENDDA IS INITIAL.
      SELECT FINCODE_ORIGIN, FINCODE_TARGET, BEGDA, ENDDA,  CUNAM, CDATE, MUNAM, MDATE
             FROM YTFM_INT_SUBST
             WHERE FIKRS = @MV_FIKRS
             INTO TABLE @MT_SUBST.
    ELSE.
      SELECT FINCODE_ORIGIN, FINCODE_TARGET, BEGDA, ENDDA, CUNAM, CDATE, MUNAM, MDATE
             FROM YTFM_INT_SUBST
             WHERE FIKRS = @MV_FIKRS
             AND   BEGDA <= @MV_ENDDA
             AND   ENDDA >= @MV_BEGDA
             INTO TABLE @MT_SUBST.
    ENDIF.

    CHECK MT_SUBST IS NOT INITIAL AND IV_REPLACE_STAR = ABAP_TRUE.

    LOOP AT MT_SUBST INTO DATA(LS_SUBST) WHERE FINCODE_ORIGIN CS '*'.
      CLEAR LT_FUND.
      REPLACE '*' WITH '%' INTO LS_SUBST-FINCODE_ORIGIN.
      SELECT FINCODE FROM FMFINCODE WHERE FIKRS = @MV_FIKRS
                                    AND   FINCODE LIKE @LS_SUBST-FINCODE_ORIGIN
                                    AND   DATBIS >= @LS_SUBST-BEGDA
                                    AND   DATAB <= @LS_SUBST-ENDDA
                     INTO TABLE @LT_FUND.
      DELETE MT_SUBST.
      LOOP AT LT_FUND INTO DATA(LV_FUND).
        LS_SUBST-FINCODE_ORIGIN = LV_FUND.
        APPEND LS_SUBST TO MT_SUBST.
      ENDLOOP.
    ENDLOOP.

    SORT MT_SUBST.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01G ----
  METHOD READ_PROJECT_FROM_DB.

    DATA LS_FUND TYPE TY_FUND.
    DATA LT_FUND_RANGE TYPE RANGE OF BP_GEBER.

    CLEAR: MT_PROJECT, MT_FUND, MT_PROJECT_SUBST.

    ME->SELECT_PROJECT_FROM_DB( EXPORTING IT_FUND = IT_FUND
                                          IT_GSBER = IT_GSBER
                                          IV_BEGDA = IV_BEGDA
                                CHANGING CT_PROJECT = MT_PROJECT ).

    "Add project corresponding to substitute fund
    LOOP AT MT_SUBST INTO DATA(LS_SUBST).
      "Check target fund is not alreay selected
      READ TABLE MT_PROJECT INTO DATA(LS_PROJECT) WITH KEY FIKRS = MV_FIKRS
                                                           FINCODE = LS_SUBST-FINCODE_TARGET.
      IF SY-SUBRC = 0.
        READ TABLE MT_PROJECT_SUBST TRANSPORTING NO FIELDS WITH KEY FIKRS = MV_FIKRS
                                                                    FINCODE = LS_SUBST-FINCODE_TARGET.
        IF SY-SUBRC <> 0.
          APPEND LS_PROJECT TO MT_PROJECT_SUBST.
        ENDIF.
      ELSE.
        "Check original fund is selected
        READ TABLE MT_PROJECT TRANSPORTING NO FIELDS WITH KEY FIKRS = MV_FIKRS
                                                              FINCODE = LS_SUBST-FINCODE_ORIGIN.
        CHECK SY-SUBRC = 0.
        APPEND VALUE #( SIGN = 'I' OPTION = 'EQ' LOW = LS_SUBST-FINCODE_TARGET ) TO LT_FUND_RANGE.
      ENDIF.
    ENDLOOP.

    IF LT_FUND_RANGE IS NOT INITIAL.
      "Complete project list
      ME->SELECT_PROJECT_FROM_DB( EXPORTING IT_FUND = LT_FUND_RANGE
                                            IT_GSBER = IT_GSBER
                                            IV_BEGDA = IV_BEGDA
                                  CHANGING CT_PROJECT = MT_PROJECT ).
      "Get in a separate table for futher statement
      ME->SELECT_PROJECT_FROM_DB( EXPORTING IT_FUND = LT_FUND_RANGE
                                            IV_BEGDA = IV_BEGDA
                                  CHANGING CT_PROJECT = MT_PROJECT_SUBST ).
    ENDIF.

    SORT MT_PROJECT.

    LOOP AT MT_PROJECT ASSIGNING FIELD-SYMBOL(<LS_PROJECT>).
      "Get project status
      <LS_PROJECT>-STATUS = ME->GET_PROJECT_STATUS( IV_OBJNR = <LS_PROJECT>-OBJNR ).
      "Exclude closed project if asked
      IF IV_EXCL_CLOSED = ABAP_TRUE AND <LS_PROJECT>-STATUS = 'CLSD' AND <LS_PROJECT>-DATBIS < MV_BEGDA.
        DELETE MT_PROJECT.
        CONTINUE.
      ENDIF.
      "Exclude UNDP projects if asked
      IF IV_EXCL_UNDP = ABAP_TRUE AND <LS_PROJECT>-YYE_DONOR(4) = 'UNDP' AND <LS_PROJECT>-FINCODE(1) CN '0123456789'.
        DELETE MT_PROJECT.
        CONTINUE.
      ENDIF.
      MOVE-CORRESPONDING <LS_PROJECT> TO LS_FUND.
      APPEND LS_FUND TO MT_FUND.
    ENDLOOP.

    SORT MT_FUND.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01H ----
  METHOD SAVE_INT_SUBST.

    DATA LV_NEW TYPE XFELD.
    DATA LT_NEW TYPE TABLE OF YTFM_INT_SUBST.
    DATA LS_NEW TYPE YTFM_INT_SUBST.
    DATA LT_OLD TYPE TABLE OF YTFM_INT_SUBST.
    DATA LS_OLD TYPE YTFM_INT_SUBST.
    DATA LT_DELETE TYPE TABLE OF BP_GEBER.
    DATA LT_INSERT TYPE TABLE OF YTFM_INT_SUBST.

    SORT MT_SUBST.

    IF MT_SUBST = MT_SUBST_O.
      MESSAGE 'No data to update' TYPE 'I'.
      EXIT.
    ENDIF.

    "Delete initial line from original
    DELETE MT_SUBST_O WHERE FINCODE_ORIGIN IS INITIAL.

    "Check funds to update
    LOOP AT MT_SUBST INTO DATA(LS_SUBST).
      "Exclude default lines
      CHECK LS_SUBST <> MS_INT_SUBST_DEFAULT.
      AT NEW FINCODE_ORIGIN.
        CLEAR: LT_NEW, LT_OLD.
      ENDAT.
      "Set to temporary table
      MOVE-CORRESPONDING LS_SUBST TO LS_NEW.
      LS_NEW-MANDT = SY-MANDT.
      LS_NEW-FIKRS = MV_FIKRS.
      APPEND LS_NEW TO LT_NEW.
      AT END OF FINCODE_ORIGIN.
        "Get original values for fund
        LOOP AT MT_SUBST_O INTO DATA(LS_SUBST_O) WHERE FINCODE_ORIGIN = LS_SUBST-FINCODE_ORIGIN.
          MOVE-CORRESPONDING LS_SUBST_O TO LS_OLD.
          LS_OLD-MANDT = SY-MANDT.
          LS_OLD-FIKRS = MV_FIKRS.
          APPEND LS_OLD TO LT_OLD.
        ENDLOOP.
        IF LT_NEW <> LT_OLD.
          LOOP AT LT_NEW ASSIGNING FIELD-SYMBOL(<LS_NEW>).
            READ TABLE LT_OLD INTO LS_OLD WITH KEY FIKRS = <LS_NEW>-FIKRS
                                                   FINCODE_ORIGIN = <LS_NEW>-FINCODE_ORIGIN
                                                   ENDDA = <LS_NEW>-ENDDA
                                                   BEGDA = <LS_NEW>-BEGDA.
            IF SY-SUBRC = 0.
              IF LS_OLD-FINCODE_TARGET <> <LS_NEW>-FINCODE_TARGET.
                <LS_NEW>-MUNAM = SY-UNAME.
                <LS_NEW>-MDATE = SY-DATUM.
              ENDIF.
            ELSE.
              <LS_NEW>-CUNAM = SY-UNAME.
              <LS_NEW>-CDATE = SY-DATUM.
            ENDIF.
          ENDLOOP.
          "Set to insert entries
          APPEND LINES OF LT_NEW TO LT_INSERT.
          "Set fund to deletion table
          APPEND LS_SUBST-FINCODE_ORIGIN TO LT_DELETE.
        ENDIF.
        "Adjust oiginal table
        DELETE MT_SUBST_O WHERE FINCODE_ORIGIN = LS_SUBST-FINCODE_ORIGIN.
      ENDAT.
    ENDLOOP.

    "Remaining entries in original table must be deleted.
    LOOP AT MT_SUBST_O INTO LS_SUBST_O.
      AT END OF FINCODE_ORIGIN.
        APPEND LS_SUBST_O-FINCODE_ORIGIN TO LT_DELETE.
      ENDAT.
    ENDLOOP.

    "Update database
    LOOP AT LT_DELETE INTO DATA(LV_FUND).
      DELETE FROM YTFM_INT_SUBST WHERE FIKRS = MV_FIKRS
                                 AND   FINCODE_ORIGIN = LV_FUND.
    ENDLOOP.

    SORT LT_INSERT.
    INSERT YTFM_INT_SUBST FROM TABLE LT_INSERT.
    IF SY-SUBRC = 0.
      COMMIT WORK.
*      CLEAR mt_subst.
*      LOOP AT lt_insert INTO ls_new.
*        MOVE-CORRESPONDING ls_new TO ls_subst.
*        APPEND ls_subst TO mt_subst.
*      ENDLOOP.
      SORT MT_SUBST.
      MT_SUBST_O = MT_SUBST.
      MESSAGE 'Data saved' TYPE 'S'.
    ELSE.
      ROLLBACK WORK.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01I ----
  METHOD SET_FINISH_TO_INT_SUBST.

    DATA LV_NEW TYPE XFELD.
    DATA LS_PREV TYPE YSFM_INT_SUBST.
    DATA LT_SUBST LIKE MT_SUBST.
    DATA LT_FUND TYPE RANGE OF BP_GEBER.

    SORT MT_SUBST.

    MV_ERROR = ABAP_FALSE.

    LOOP AT MT_SUBST INTO DATA(LS_SUBST).
      LV_NEW = ABAP_FALSE.
      AT NEW FINCODE_ORIGIN.
        LV_NEW = ABAP_TRUE.
      ENDAT.
      IF LV_NEW = ABAP_FALSE.
        IF LS_SUBST-BEGDA <= LS_PREV-ENDDA.
          MESSAGE I031(YFM1) WITH LS_SUBST-FINCODE_ORIGIN.
          MV_ERROR = ABAP_TRUE.
          EXIT.
        ENDIF.
      ENDIF.
      LS_PREV = LS_SUBST.
    ENDLOOP.

    "Check if generic lines (with star) not in conflict with other lines
    LT_SUBST = MT_SUBST.
    DELETE LT_SUBST WHERE FINCODE_ORIGIN CS '*'.
    LOOP AT MT_SUBST INTO DATA(LS_SUBST_STAR) WHERE FINCODE_ORIGIN CS '*'.
      LT_FUND = VALUE #( ( SIGN = 'I' OPTION = 'CP' LOW = LS_SUBST_STAR-FINCODE_ORIGIN ) ).
      LOOP AT LT_SUBST INTO LS_SUBST WHERE FINCODE_ORIGIN IN LT_FUND
                       AND   BEGDA <= LS_SUBST_STAR-ENDDA
                       AND   ENDDA >= LS_SUBST_STAR-BEGDA.
        MESSAGE I038(YFM1) WITH LS_SUBST-FINCODE_ORIGIN LS_SUBST_STAR-FINCODE_ORIGIN.
        MV_ERROR = ABAP_TRUE.
        EXIT.
      ENDLOOP.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01J ----
  METHOD SET_MODIF_TO_INT_SUBST.

    TYPES LTTY_INT_SUBST TYPE TABLE OF YSFM_INT_SUBST.
    FIELD-SYMBOLS <LT_MODIFIED> TYPE LTTY_INT_SUBST.
    DATA LS_MODIFIED TYPE YSFM_INT_SUBST.
    DATA LV_ENDDA TYPE ENDDA.
    DATA LV_DATE TYPE DATUM.

    ASSIGN ER_DATA_CHANGED->MP_MOD_ROWS->* TO <LT_MODIFIED>.

    LOOP AT ER_DATA_CHANGED->MT_GOOD_CELLS INTO DATA(LS_GOOD_CELLS).
      "Check empty values
      CASE LS_GOOD_CELLS-FIELDNAME.
        WHEN 'FINCODE_ORIGIN' OR 'FINCODE_TARGET'.
          IF LS_GOOD_CELLS-VALUE IS INITIAL.
            CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
              EXPORTING
                I_MSGID     = 'YFM1'
                I_MSGNO     = '027'
                I_MSGTY     = 'E'
                I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
            MV_ERROR = ABAP_TRUE.
          ELSE.
            "Check fund: allow star use for original fund
            IF NOT ( LS_GOOD_CELLS-FIELDNAME = 'FINCODE_ORIGIN' AND LS_GOOD_CELLS-VALUE CS '*' ).
              SELECT SINGLE * FROM FMFINCODE WHERE FIKRS = @MV_FIKRS
                                             AND   FINCODE = @LS_GOOD_CELLS-VALUE
                              INTO @DATA(LS_FMFINCODE).
              IF SY-SUBRC <> 0.
                CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
                  EXPORTING
                    I_MSGID     = 'YFM1'
                    I_MSGNO     = '032'
                    I_MSGTY     = 'E'
                    I_MSGV1     = LS_GOOD_CELLS-VALUE
                    I_MSGV2     = MV_FIKRS
                    I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                    I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
                MV_ERROR = ABAP_TRUE.
              ENDIF.
            ENDIF.
          ENDIF.

        WHEN 'BEGDA' OR 'ENDDA'.
          IF LS_GOOD_CELLS-VALUE = '00000000'.
            CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
              EXPORTING
                I_MSGID     = 'YFM1'
                I_MSGNO     = '027'
                I_MSGTY     = 'E'
                I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
            MV_ERROR = ABAP_TRUE.
          ELSE.
            IF LS_GOOD_CELLS-FIELDNAME = 'BEGDA'.
              "check it's a first date of month
              IF LS_GOOD_CELLS-VALUE+6(2) <> '01'.
                CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
                  EXPORTING
                    I_MSGID     = 'YFM1'
                    I_MSGNO     = '034'
                    I_MSGTY     = 'E'
                    I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                    I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
                MV_ERROR = ABAP_TRUE.
              ENDIF.
            ENDIF.
            IF LS_GOOD_CELLS-FIELDNAME = 'ENDDA'.
              "check it's a last date of month
              LV_ENDDA = LS_GOOD_CELLS-VALUE(8).
              LV_DATE = YCL_CA_UTILITIES=>GET_LAST_DAY_OF_MONTH( IV_DATE = LV_ENDDA ).
              IF LV_ENDDA <> LV_DATE.
                CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
                  EXPORTING
                    I_MSGID     = 'YFM1'
                    I_MSGNO     = '035'
                    I_MSGTY     = 'E'
                    I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                    I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
                MV_ERROR = ABAP_TRUE.
              ENDIF.
            ENDIF.
          ENDIF.
      ENDCASE.

    ENDLOOP.

  ENDMETHOD.

