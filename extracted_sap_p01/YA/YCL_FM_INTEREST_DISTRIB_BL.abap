  METHOD CHECK_MODIFIED_INT_CBINST.

    EV_MODIFIED = ABAP_FALSE.

    IF MT_INT_CBINST <> MT_INT_CBINST_O.
      EV_MODIFIED = ABAP_TRUE.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM00L ----
  METHOD MANAGE_PROJECT_STATUS.

    DATA LS_LAYOUT TYPE LVC_S_LAYO.

    "Set default value
    MS_INT_PROJS_DEFAULT-MANDT = SY-MANDT.
    MS_INT_PROJS_DEFAULT-STATUS = C_PRE_CLOSED.
    "Get initial data in DB
    ME->READ_INT_PROJS_FROM_DB( ).
    "Set initial line if no data
    IF MT_INT_PROJS IS INITIAL.
      APPEND MS_INT_PROJS_DEFAULT TO MT_INT_PROJS.
    ENDIF.
    "Initialize original table
    MT_INT_PROJS_O = MT_INT_PROJS.

    "Get field catalog
    ME->GET_FIELDCAT( IV_STRUCTURE = 'YTFM_INT_PROJS' ).
    "Set field properties
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'IYEAR' IV_KEY = ABAP_TRUE IV_EDIT = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'IMONTH' IV_KEY = ABAP_TRUE IV_EDIT = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'PSPNR' IV_KEY = ABAP_TRUE IV_EDIT = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'STATUS' IV_EDIT = ABAP_TRUE IV_OUTPUTLENGTH = 10 IV_AUTO_VALUE = ABAP_TRUE ).

    MO_GRID->SET_TABLE_FOR_FIRST_DISPLAY( EXPORTING IT_TOOLBAR_EXCLUDING = MT_EXCLUDE_FCT
                                                    IS_LAYOUT = LS_LAYOUT
                                          CHANGING IT_FIELDCATALOG = MT_FIELDCAT
                                                   IT_OUTTAB = MT_INT_PROJS ).

    MO_GRID->SET_READY_FOR_INPUT( EXPORTING I_READY_FOR_INPUT = 1 ).
    "Handle enter event
    MO_GRID->REGISTER_EDIT_EVENT( EXPORTING I_EVENT_ID = CL_GUI_ALV_GRID=>MC_EVT_ENTER ).
    SET HANDLER ME->HANDLE_DATA_CHANGED FOR MO_GRID.
    SET HANDLER ME->HANDLE_DATA_CHANGED_FINISHED FOR MO_GRID.
    "Method inside handler to set modification
    MV_CHANGED_METHOD = 'SET_MODIF_TO_INT_PROJS'.
    MV_CHANGED_FINISHED_METHOD = 'SET_FINISH_TO_INT_PROJS'.
    MV_SAVE_METHOD = 'SAVE_INT_PROJS'.
    MV_CHECK_MODIFIED_METHOD = 'CHECK_MODIFIED_INT_PROJS'.
    MV_TABLE_NAME = 'YTFM_INT_PROJS'.

