  METHOD GET_INT_PROJECT_STATUS.

    "Get the pre-closed project
    READ TABLE MT_INT_PROJS INTO DATA(LS_INT_PROJS) WITH KEY PSPNR = IV_PSPNR.
    CHECK SY-SUBRC = 0.
    RV_STATUS = LS_INT_PROJS-STATUS.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01O ----
  METHOD SELECT_PROJECT_FROM_DB.

    SELECT DISTINCT A~FIKRS,
                    A~FINCODE,
                    C~VBUKR AS BUKRS,
                    A~DATAB,
                    A~DATBIS,
                    C~PSPNR,
                    C~OBJNR,
                    D~YYE_PRCRT,
                    D~YYE_DONOR
           FROM FMFINCODE AS A
           INNER JOIN PROJ AS C ON  C~PSPID = A~FINCODE
           LEFT OUTER JOIN PRPS AS D ON D~POSID = C~PSPID
           WHERE A~FIKRS = @MV_FIKRS
           AND   A~FINCODE IN @IT_FUND
           AND   A~DATAB <= @MV_ENDDA
           AND   A~DATBIS >= @IV_BEGDA
           AND   C~VGSBR IN @IT_GSBER
           APPENDING CORRESPONDING FIELDS OF TABLE @CT_PROJECT.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01P ----
  METHOD CHECK_BAL_EXISTS_AFTER_DATE.

    DATA LV_PERIO(6) TYPE N.
    DATA LV_INDEX(1) TYPE N.
    DATA LV_FIELDNAME TYPE FIELDNAME.

    RV_EXISTS = ABAP_FALSE.

    LOOP AT MT_PERIOD INTO DATA(LS_PERIOD).
      ADD 1 TO LV_INDEX.
      LV_PERIO = |{ LS_PERIOD-GJAHR }{ LS_PERIOD-MONTH }|.
      CHECK IS_DATA-DATBIS(6) <= LV_PERIO.
      LV_FIELDNAME = |IS_DATA-CASH_BAL_M{ LV_INDEX }|.
      ASSIGN (LV_FIELDNAME) TO FIELD-SYMBOL(<CASH_BAL>).
      IF <CASH_BAL> > 0.
        RV_EXISTS = ABAP_TRUE.
        EXIT.
      ENDIF.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01Q ----
  METHOD FILTER_AND_SET_HEADER_DATA.

    FIELD-SYMBOLS <LS_HEADER> TYPE TY_HEADER.


    LOOP AT MT_LIST_DET_I ASSIGNING FIELD-SYMBOL(<LS_LIST_DET>).

      "Get consolidated line
      READ TABLE MT_LIST_PRE_I INTO DATA(LS_LIST_PRE) WITH KEY RETENTION_RULE = <LS_LIST_DET>-RETENTION_RULE
                                                               CODE_TO_CREDIT = <LS_LIST_DET>-CODE_TO_CREDIT.
      CHECK SY-SUBRC = 0.

      "Put in the correct header line
      IF <LS_LIST_DET>-FINCODE IS NOT INITIAL.   "Fund
        READ TABLE MT_HEADER ASSIGNING <LS_HEADER> INDEX 1.   "Fund
        "Set 'Valid fund' icon
        IF LS_LIST_PRE-INT_PROJ_STATUS = C_PRE_CLOSED.   "Pre-closed
          WRITE ICON_LED_YELLOW TO <LS_LIST_DET>-FINCODE_STATUS AS ICON.
        ELSEIF LS_LIST_PRE-DATBIS < MV_BEGDA.   "fund is closed
          WRITE ICON_LED_RED TO <LS_LIST_DET>-FINCODE_STATUS AS ICON.
        ELSEIF LS_LIST_PRE-DATBIS >= MV_ENDDA.  "fund is valid
          WRITE ICON_LED_GREEN TO <LS_LIST_DET>-FINCODE_STATUS AS ICON.
        ELSE.
          IF ME->CHECK_BAL_EXISTS_AFTER_DATE( IS_DATA = LS_LIST_PRE ) = ABAP_TRUE.   "cash bal exists from fund end date
            WRITE ICON_MESSAGE_WARNING TO <LS_LIST_DET>-FINCODE_STATUS AS ICON.
          ELSE.
            WRITE ICON_LED_GREEN TO <LS_LIST_DET>-FINCODE_STATUS AS ICON.
          ENDIF.
        ENDIF.

      ELSE.  "Institute
        READ TABLE MT_INST INTO DATA(LS_INST) WITH KEY INSTITUTE_TEXT = <LS_LIST_DET>-CODE_TO_CREDIT.
        IF LS_INST-WITH_GL = ABAP_TRUE.
          READ TABLE MT_HEADER ASSIGNING <LS_HEADER> INDEX 2.   "Institute with G/L account
        ELSE.
          READ TABLE MT_HEADER ASSIGNING <LS_HEADER> INDEX 3.   "Institute without G/L account
        ENDIF.
      ENDIF.

      IF LS_LIST_PRE-CASH_BAL_M1 < 0.
        WRITE ICON_INTERVAL_EXCLUDE_RED TO <LS_LIST_DET>-EXCL_CASH_BAL_M1 AS ICON.
      ELSE.
        ADD <LS_LIST_DET>-CASH_BAL_M1 TO <LS_HEADER>-AMOUNT_MONTH_1.
      ENDIF.
      IF LS_LIST_PRE-CASH_BAL_M2 < 0.
        WRITE ICON_INTERVAL_EXCLUDE_RED TO <LS_LIST_DET>-EXCL_CASH_BAL_M2 AS ICON.
      ELSE.
        ADD <LS_LIST_DET>-CASH_BAL_M2 TO <LS_HEADER>-AMOUNT_MONTH_2.
      ENDIF.
      IF LS_LIST_PRE-CASH_BAL_M3 < 0.
        WRITE ICON_INTERVAL_EXCLUDE_RED TO <LS_LIST_DET>-EXCL_CASH_BAL_M3 AS ICON.
      ELSE.
        ADD <LS_LIST_DET>-CASH_BAL_M3 TO <LS_HEADER>-AMOUNT_MONTH_3.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01R ----
  METHOD GROUP_BY_CODE_TO_CREDIT.

    DATA LS_LIST_DET TYPE YSFM_INT_REP_FUND.
    DATA LV_NEW TYPE XFELD.
    DATA LT_LIST_PRE_I  TYPE TABLE OF YSFM_INT_REP_FUND.


    LOOP AT MT_LIST_PRE_I INTO DATA(LS_LIST_PRE).

      LV_NEW = ABAP_FALSE.

      AT NEW CODE_TO_CREDIT.
        LV_NEW = ABAP_TRUE.
        CLEAR LS_LIST_DET.
      ENDAT.

      IF LV_NEW = ABAP_TRUE.
        LS_LIST_DET = LS_LIST_PRE.
      ELSE.
        ADD LS_LIST_PRE-DEDUCTION_M1 TO LS_LIST_DET-DEDUCTION_M1.
        ADD LS_LIST_PRE-DEDUCTION_M2 TO LS_LIST_DET-DEDUCTION_M2.
        ADD LS_LIST_PRE-DEDUCTION_M3 TO LS_LIST_DET-DEDUCTION_M3.
        ADD LS_LIST_PRE-CASH_M1 TO LS_LIST_DET-CASH_M1.
        ADD LS_LIST_PRE-CASH_M2 TO LS_LIST_DET-CASH_M2.
        ADD LS_LIST_PRE-CASH_M3 TO LS_LIST_DET-CASH_M3.
        ADD LS_LIST_PRE-CASH_BAL_M1 TO LS_LIST_DET-CASH_BAL_M1.
        ADD LS_LIST_PRE-CASH_BAL_M2 TO LS_LIST_DET-CASH_BAL_M2.
        ADD LS_LIST_PRE-CASH_BAL_M3 TO LS_LIST_DET-CASH_BAL_M3.
        ADD LS_LIST_PRE-TOTAL_CASH_BAL TO LS_LIST_DET-TOTAL_CASH_BAL.
      ENDIF.

      AT END OF CODE_TO_CREDIT.
        APPEND LS_LIST_DET TO LT_LIST_PRE_I.
      ENDAT.

    ENDLOOP.

    MT_LIST_PRE_I = LT_LIST_PRE_I.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01S ----
  METHOD HANDLE_BOTTOM_LIST.

    TYPES: BEGIN OF LTY_ICON,
             ICON TYPE AQICON,
             NAME TYPE TEXT50,
           END OF LTY_ICON.

    DATA LT_ICON TYPE TABLE OF LTY_ICON.
    DATA LO_ALV_POPUP TYPE REF TO YCL_CA_ALV_IN_POPUP.

    CASE E_SALV_FUNCTION.
      WHEN 'YICON'.
        LT_ICON = VALUE #( ( ICON = ICON_LED_GREEN NAME = 'Valid fund for whole quarter' )
                           ( ICON = ICON_LED_YELLOW NAME = 'Project pre-closed' )
                           ( ICON = ICON_LED_RED NAME = 'Fund not valid for quarter' )
                           ( ICON = ICON_MESSAGE_WARNING NAME = 'Fund closed during quarter' )
                           ( ICON = ICON_CLOSE NAME = 'Project closed since quarter: goes to MCA' )
                           ( ICON = ICON_INCOMING_EMPLOYEE NAME = 'Exception from selection-screen: goes to MCA' ) ).
        IF MV_LIST_TYPE = 'D'.
          APPEND VALUE #( ICON = ICON_INTERVAL_EXCLUDE_RED NAME = 'Excluded from cash balance' ) TO LT_ICON.
        ENDIF.

        LO_ALV_POPUP = NEW YCL_CA_ALV_IN_POPUP( ).
        LO_ALV_POPUP->EXECUTE( EXPORTING IV_TITLE = 'Icons legend'
                                         IV_START_ROW = 4
                                         IV_START_COL = 4
                                         IV_END_ROW = 10
                                         IV_END_COL = 40
                               CHANGING CT_TABLE = LT_ICON ).

    ENDCASE.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01T ----
  METHOD PREPARE_INSTITUTE_DATA.

    DATA LS_LIST TYPE YSFM_INT_REP1.
    DATA LS_LIST_PRE TYPE YSFM_INT_REP_FUND.
    DATA LV_INDEX(1) TYPE N.
    DATA LV_FIELDNAME TYPE FIELDNAME.
    FIELD-SYMBOLS <FIELD> TYPE ANY.


    LOOP AT MT_INST INTO DATA(LS_INST).
      CLEAR: LV_INDEX, LS_LIST, LS_LIST_PRE.
      LS_LIST-CODE_TO_CREDIT = LS_INST-INSTITUTE_TEXT.
      LS_LIST-RETENTION_RULE = LS_INST-RETENTION_RULE.
      LOOP AT MT_PERIOD INTO DATA(LS_PERIOD).
        ADD 1 TO LV_INDEX.
        LV_FIELDNAME = |LS_LIST-CASH_BAL_M{ LV_INDEX }|.
        ASSIGN (LV_FIELDNAME) TO <FIELD>.
        IF LS_INST-WITH_GL = ABAP_TRUE.
          <FIELD> = ME->GET_GLT0_AMOUNT( IV_INSTITUTE = LS_INST-INSTITUTE
                                         IV_YEAR = LS_PERIOD-GJAHR
                                         IV_MONTH = LS_PERIOD-MONTH ).
          LS_LIST-WAERS = MV_CURRENCY.
        ELSE.
          READ TABLE MT_INT_CBINST INTO DATA(LS_CBINST) WITH KEY IYEAR = LS_PERIOD-GJAHR
                                                                 IMONTH = LS_PERIOD-MONTH
                                                                 INSTITUTE = LS_INST-INSTITUTE.
          IF SY-SUBRC = 0.
            <FIELD> = LS_CBINST-CASH_BAL.
            LS_LIST-WAERS = LS_CBINST-WAERS.
          ELSE.
            <FIELD> = 0.
            LS_LIST-WAERS = MV_CURRENCY.
          ENDIF.
        ENDIF.

      ENDLOOP.
      "ls_list-total_cash_bal = ls_list-cash_bal_m1 + ls_list-cash_bal_m2 + ls_list-cash_bal_m3.
      APPEND LS_LIST TO MT_LIST_DET_I.
      MOVE-CORRESPONDING LS_LIST TO LS_LIST_PRE.
      APPEND LS_LIST_PRE TO MT_LIST_PRE_I.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01U ----
  METHOD PREPARE_PROJECT_DATA.

    TYPES: BEGIN OF LTY_DATA,
             PSPID           TYPE YSFM_INT_REP1-PSPID,
             FINCODE         TYPE YSFM_INT_REP1-FINCODE,
             INDEX(1)        TYPE N,
             DEDUCTION       TYPE YSFM_INT_REP1-DEDUCTION_M1,
             CASH            TYPE YSFM_INT_REP1-CASH_M1,
           END OF LTY_DATA.

    DATA LT_DATA TYPE TABLE OF LTY_DATA.
    DATA LS_DATA TYPE LTY_DATA.
    DATA LV_DATE TYPE DATUM.
    DATA LS_LIST TYPE YSFM_INT_REP1.
    DATA LS_LIST_PRE TYPE YSFM_INT_REP_FUND.
    DATA LV_INDEX(1) TYPE N.
    DATA LV_FIELDNAME TYPE FIELDNAME.
    FIELD-SYMBOLS <FIELD> TYPE ANY.
    DATA LV_AMOUNT TYPE WERTV9.

    LOOP AT MT_PROJECT INTO DATA(LS_PROJECT).
      CLEAR: LT_DATA, LV_INDEX, LV_AMOUNT.

      "Get amounts
      LOOP AT MT_PERIOD INTO DATA(LS_PERIOD).
        CLEAR LS_DATA.
        ADD 1 TO LV_INDEX.
        LS_DATA-PSPID = LS_PROJECT-FINCODE.
        LS_DATA-INDEX = LV_INDEX.
        LV_DATE = |{ LS_PERIOD-GJAHR }{ LS_PERIOD-MONTH }01|.
        "Check if substituted fund
        LOOP AT MT_SUBST INTO DATA(LS_SUBST) WHERE FINCODE_ORIGIN = LS_PROJECT-FINCODE
                                             AND   BEGDA <= LV_DATE
                                             AND   ENDDA >= LV_DATE.
          EXIT.
        ENDLOOP.
        IF SY-SUBRC = 0.
          LS_DATA-FINCODE = LS_SUBST-FINCODE_TARGET.
        ELSE.
          LS_DATA-FINCODE = LS_PROJECT-FINCODE.
        ENDIF.
        "Get deduction for project
        READ TABLE MT_INT_DEDU INTO DATA(LS_DEDU) WITH KEY IYEAR = LS_PERIOD-GJAHR
                                                           IMONTH = LS_PERIOD-MONTH
                                                           PSPNR = LS_PROJECT-PSPNR.
        IF SY-SUBRC = 0.
          LS_DATA-DEDUCTION = LS_DEDU-DEDUCTION.
        ENDIF.

        "Determine cach balance
        "Report cash balane from previous month
        LS_DATA-CASH = LV_AMOUNT.
        "Get cash balance
        LV_AMOUNT = ME->GET_FMIT_AMOUNT( IV_FIKRS = LS_PROJECT-FIKRS
                                         IV_FINCODE = LS_PROJECT-FINCODE
                                         IV_YEAR = LS_PERIOD-GJAHR
                                         IV_MONTH = LS_PERIOD-MONTH
                                         IV_INDEX = LV_INDEX ).
        ADD LV_AMOUNT TO LS_DATA-CASH.
        "Insert to table
        APPEND LS_DATA TO LT_DATA.
        "Keep amount to report to next month
        LV_AMOUNT = LS_DATA-CASH.
      ENDLOOP.

      "Exclude project with cash balance <> 0 for the quarter
      LOOP AT LT_DATA TRANSPORTING NO FIELDS WHERE CASH <> 0.
        EXIT.
      ENDLOOP.
      CHECK SY-SUBRC = 0.

      "Set to list table
      SORT LT_DATA.

      LOOP AT LT_DATA INTO LS_DATA.
        AT NEW FINCODE.
          CLEAR: LS_LIST, LS_LIST_PRE.
          LS_LIST-PSPID = LS_DATA-PSPID.
          LS_LIST-CODE_TO_CREDIT = LS_LIST-FINCODE = LS_DATA-FINCODE.
          LS_LIST-PROJ_STATUS = LS_PROJECT-STATUS.
          IF LS_PROJECT-YYE_DONOR(4) = 'UNDP'.
            LS_LIST-UNDP_PROJ = ABAP_TRUE.
          ENDIF.
          LS_LIST-RETENTION_RULE = ME->GET_RETENTION_RULE( IV_YYE_PRCRT = LS_PROJECT-YYE_PRCRT ).
          "Check if substituted fund
          IF LS_DATA-FINCODE <> LS_PROJECT-FINCODE.
            READ TABLE MT_PROJECT_SUBST INTO DATA(LS_PROJECT_SUBST) WITH KEY FIKRS = LS_PROJECT-FIKRS
                                                                             FINCODE = LS_DATA-FINCODE.
            IF SY-SUBRC = 0.
              LS_LIST-DATAB = LS_PROJECT_SUBST-DATAB.
              LS_LIST-DATBIS = LS_PROJECT_SUBST-DATBIS.
              LS_LIST-INT_PROJ_STATUS = ME->GET_INT_PROJECT_STATUS( IV_PSPNR = LS_PROJECT_SUBST-PSPNR ).
            ENDIF.
          ELSE.
            LS_LIST-DATAB = LS_PROJECT-DATAB.
            LS_LIST-DATBIS = LS_PROJECT-DATBIS.
            LS_LIST-INT_PROJ_STATUS = ME->GET_INT_PROJECT_STATUS( IV_PSPNR = LS_PROJECT-PSPNR ).
          ENDIF.
        ENDAT.
        "Deduction
        LV_FIELDNAME = |LS_LIST-DEDUCTION_M{ LS_DATA-INDEX }|.
        ASSIGN (LV_FIELDNAME) TO <FIELD>.
        <FIELD> = LS_DATA-DEDUCTION.
        "Cash
        LV_FIELDNAME = |LS_LIST-CASH_M{ LS_DATA-INDEX }|.
        ASSIGN (LV_FIELDNAME) TO <FIELD>.
        <FIELD> = LS_DATA-CASH.
        "Cash balance
        LV_FIELDNAME = |LS_LIST-CASH_BAL_M{ LS_DATA-INDEX }|.
        ASSIGN (LV_FIELDNAME) TO <FIELD>.
        <FIELD> = LS_DATA-CASH - LS_DATA-DEDUCTION.

        AT END OF FINCODE.
          LS_LIST-WAERS = MV_CURRENCY.
          "ls_list-total_cash_bal = ls_list-cash_bal_m1 + ls_list-cash_bal_m2 + ls_list-cash_bal_m3.
          APPEND LS_LIST TO MT_LIST_DET_I.
          MOVE-CORRESPONDING LS_LIST TO LS_LIST_PRE.
          APPEND LS_LIST_PRE TO MT_LIST_PRE_I.
        ENDAT.
      ENDLOOP.

    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01V ----
  METHOD READ_INT_PROJS_FROM_DB_REPORT.

    DATA LV_PERIOD_INT(6) TYPE N.
    DATA LV_PERIOD_TO(6) TYPE N.

    LV_PERIOD_TO = |{ IV_PERIOD_TO-GJAHR }{ IV_PERIOD_TO-MONTH }|.

    SELECT * FROM YTFM_INT_PROJS WHERE STATUS = 'P' INTO TABLE @MT_INT_PROJS.

    LOOP AT MT_INT_PROJS INTO DATA(LS_INT_PROJS).
      LV_PERIOD_INT = |{ LS_INT_PROJS-IYEAR }{ LS_INT_PROJS-IMONTH }|.
      IF LV_PERIOD_INT > LV_PERIOD_TO.
        DELETE MT_INT_PROJS.
      ENDIF.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01W ----
  METHOD READ_MCA_FUND.

    CLEAR MT_MCA_FUND.

    CHECK IT_FUND IS NOT INITIAL.

    SELECT FIKRS, FINCODE FROM FMFINCODE WHERE FIKRS = @MV_FIKRS
                                         AND   FINCODE IN @IT_FUND
                          INTO CORRESPONDING FIELDS OF TABLE @MT_MCA_FUND.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01X ----
  METHOD DO_ROUNDING_DISTRIBUTION.

    DATA LV_ROUNDED_DISTRIB TYPE YE_FM_INTEREST_DISTRIBUTED.

    CHECK CV_INT_DISTRIB <> 0.

    "Round interest distibuted amount
    LV_ROUNDED_DISTRIB = ROUND( VAL = CV_INT_DISTRIB DEC = 0 ).

    "Put the cents to MCA credit
    CV_MCA_CREDIT = CV_MCA_CREDIT + ( CV_INT_DISTRIB - LV_ROUNDED_DISTRIB ).

    CV_INT_DISTRIB = LV_ROUNDED_DISTRIB.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01Y ----
  METHOD CHECK_AUTHORITY.

    CLEAR: EV_DISPLAY, EV_DISTRIBUTE, EV_POST_SIMU, EV_POST_EXEC.

******** For test phase only
    EV_DISPLAY = ABAP_TRUE.
    EV_DISTRIBUTE = ABAP_TRUE.
    EV_POST_CHECK = ABAP_TRUE.
    EV_POST_SIMU = ABAP_FALSE.
    EV_POST_EXEC = ABAP_FALSE.
    EXIT.
********

    IF IV_CHECK_DISPLAY = ABAP_TRUE.
      "Check display authorization
      AUTHORITY-CHECK OBJECT 'Y_FMINTDI'
               ID 'ACTVT' FIELD '03'.
      IF SY-SUBRC = 0.
        EV_DISPLAY = ABAP_TRUE.
      ENDIF.
    ENDIF.

    IF IV_CHECK_DISTRIBUTE = ABAP_TRUE.
      "Check distribute authorization
      AUTHORITY-CHECK OBJECT 'Y_FMINTDI'
               ID 'ACTVT' FIELD '59'.
      IF SY-SUBRC = 0.
        EV_DISTRIBUTE = ABAP_TRUE.
      ENDIF.
    ENDIF.

    IF IV_CHECK_POST = ABAP_TRUE.
      "Check posting (check) authorization
      AUTHORITY-CHECK OBJECT 'Y_FMINTDI'
               ID 'ACTVT' FIELD '39'.
      IF SY-SUBRC = 0.
        EV_POST_CHECK = ABAP_TRUE.
      ENDIF.
      "Check posting (simulation) authorization
      AUTHORITY-CHECK OBJECT 'Y_FMINTDI'
               ID 'ACTVT' FIELD '48'.
      IF SY-SUBRC = 0.
        EV_POST_SIMU = ABAP_TRUE.
      ENDIF.
      "Check posting (execution) authorization
      AUTHORITY-CHECK OBJECT 'Y_FMINTDI'
               ID 'ACTVT' FIELD '10'.
      IF SY-SUBRC = 0.
        EV_POST_SIMU = ABAP_TRUE.
        EV_POST_EXEC = ABAP_TRUE.
      ENDIF.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01Z ----
  METHOD DO_POSTING.

    DATA LS_HEADER TYPE BAPIACHE09.
    DATA LT_ITEM TYPE TABLE OF BAPIACGL09.
    DATA LS_ITEM TYPE BAPIACGL09.
    DATA LT_AMOUNT TYPE TABLE OF BAPIACCR09.
    DATA LS_AMOUNT TYPE BAPIACCR09.
    DATA LV_POSTING_DATE TYPE DATUM.
    DATA LT_RETURN TYPE TABLE OF BAPIRET2.
    DATA LS_RETURN TYPE BAPIRET2.
    DATA LV_OBJ_KEY TYPE BAPIACHE09-OBJ_KEY.
    DATA LS_POSTING_RESULT TYPE TY_POSTING_RESULT.
    DATA LV_ERROR TYPE XFELD.
    DATA LT_POSTING_ERROR TYPE TABLE OF TY_POSTING_RESULT.
    DATA LT_POSTING_OK TYPE TABLE OF TY_POSTING_RESULT.
    DATA LS_COLOR TYPE LVC_S_SCOL.
    DATA LV_TABIX TYPE SY-TABIX.

    CLEAR: MT_POSTING_RESULT, RV_EXIT_DONE.

    "Check if posting to do
    IF MT_POSTING IS INITIAL.
      MESSAGE I024(YFI1).
      RV_EXIT_DONE = ABAP_TRUE.
      EXIT.
    ENDIF.

    IF IV_MODE = C_POST.
      "Check if runid has already been executed
      ME->GET_RUNID( IMPORTING EV_INT_RUNID = DATA(LV_INT_RUNID)
                               ES_INT_RUNID = DATA(LS_INT_RUNID) ).
      IF LS_INT_RUNID-INT_RUNID IS NOT INITIAL.
        MESSAGE I021(YFI1) WITH LS_INT_RUNID-INT_RUNID LS_INT_RUNID-CUNAM LS_INT_RUNID-CDATE LS_INT_RUNID-CTIME.
        "Posting &1 already done by &2 the &3 &4
        RV_EXIT_DONE = ABAP_TRUE.
        EXIT.
      ENDIF.
      "Lock runid
      CALL FUNCTION 'ENQUEUE_EYFM_INT_POST'
        EXPORTING
          MODE_YTFM_INT_RUNID = 'E'
          MANDT               = SY-MANDT
          INT_RUNID           = LV_INT_RUNID
        EXCEPTIONS
          FOREIGN_LOCK        = 1
          SYSTEM_FAILURE      = 2
          OTHERS              = 3.
      IF SY-SUBRC <> 0.
        MESSAGE ID SY-MSGID TYPE 'I' NUMBER SY-MSGNO WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
        RV_EXIT_DONE = ABAP_TRUE.
        EXIT.
      ENDIF.
    ENDIF.

    "Set posting date to last day of quarter
    LOOP AT MT_PERIOD INTO DATA(LS_PERIOD).
    ENDLOOP.
    LV_POSTING_DATE = |{ LS_PERIOD-GJAHR }{ LS_PERIOD-MONTH }01|.
    LV_POSTING_DATE = YCL_CA_UTILITIES=>GET_LAST_DAY_OF_MONTH( IV_DATE = LV_POSTING_DATE ).

    DATA(LV_LINES) = LINES( MT_POSTING ).

    LOOP AT MT_POSTING INTO DATA(LS_POSTING).

      LV_TABIX = SY-TABIX.

      CL_PROGRESS_INDICATOR=>PROGRESS_INDICATE( I_TEXT = |Posting { SY-TABIX } on { LV_LINES }|
                                                I_PROCESSED = LV_TABIX
                                                I_TOTAL = LV_LINES
                                                I_OUTPUT_IMMEDIATELY = ABAP_TRUE ).

      "Prepare data for BAPI
      CLEAR: LS_HEADER, LS_ITEM, LT_ITEM, LS_AMOUNT, LT_AMOUNT, LT_RETURN, LV_OBJ_KEY, LS_POSTING_RESULT, LV_ERROR.
      "Header
      LS_HEADER-OBJ_TYPE = 'BKPFF'.
      LS_HEADER-BUS_ACT = 'RFBU'.
      LS_HEADER-USERNAME = SY-UNAME.
      LS_HEADER-COMP_CODE = MV_BUKRS.
      LS_HEADER-DOC_TYPE = 'JV'.
      LS_HEADER-PSTNG_DATE = LS_HEADER-DOC_DATE = LV_POSTING_DATE.
      LS_HEADER-HEADER_TXT = LS_POSTING-HEADER_TXT.
      "Item
      LOOP AT LS_POSTING-ITEM INTO DATA(LS_POSTING_ITEM).
        CLEAR: LS_ITEM, LS_AMOUNT.
        MOVE-CORRESPONDING LS_POSTING_ITEM TO LS_ITEM.
        APPEND LS_ITEM TO LT_ITEM.
        MOVE-CORRESPONDING LS_POSTING_ITEM TO LS_AMOUNT.
        APPEND LS_AMOUNT TO LT_AMOUNT.
      ENDLOOP.

      CASE IV_MODE.
        WHEN C_CHECK.   "Check only
          CALL FUNCTION 'BAPI_ACC_DOCUMENT_CHECK'
            EXPORTING
              DOCUMENTHEADER = LS_HEADER
            TABLES
              ACCOUNTGL      = LT_ITEM
              CURRENCYAMOUNT = LT_AMOUNT
              RETURN         = LT_RETURN.
        WHEN C_SIMU OR C_POST.  "Simulation or posting
          CALL FUNCTION 'BAPI_ACC_DOCUMENT_POST'
            EXPORTING
              DOCUMENTHEADER = LS_HEADER
            IMPORTING
              OBJ_KEY        = LV_OBJ_KEY
            TABLES
              ACCOUNTGL      = LT_ITEM
              CURRENCYAMOUNT = LT_AMOUNT
              RETURN         = LT_RETURN.
      ENDCASE.

      "Set result
      LS_POSTING_RESULT-CODE_TO_CREDIT = LS_POSTING-CODE_TO_CREDIT.
      IF LV_OBJ_KEY IS NOT INITIAL.
        LS_POSTING_RESULT-BUKRS = LV_OBJ_KEY+10(4).
        LS_POSTING_RESULT-BELNR = LV_OBJ_KEY(10).
        LS_POSTING_RESULT-GJAHR = LV_OBJ_KEY+14(4).
      ENDIF.

      "Check if errors
      READ TABLE LT_RETURN TRANSPORTING NO FIELDS WITH KEY TYPE = 'E'.
      IF SY-SUBRC = 0.
        LV_ERROR = ABAP_TRUE.
      ENDIF.
      READ TABLE LT_RETURN TRANSPORTING NO FIELDS WITH KEY TYPE = 'A'.
      IF SY-SUBRC = 0.
        LV_ERROR = ABAP_TRUE.
      ENDIF.

      LOOP AT LT_RETURN INTO LS_RETURN.
        IF LV_ERROR = ABAP_TRUE.
          CHECK LS_RETURN-TYPE = 'E' OR LS_RETURN-TYPE = 'A'.
        ENDIF.
        LS_POSTING_RESULT-MESSAGE = LS_RETURN-MESSAGE.
        LS_POSTING_RESULT-TYPE = LS_RETURN-TYPE.
        LS_POSTING_RESULT-TYPE_ICON = ME->GET_ICON_FORM_MESSAGE_TYPE( LS_RETURN-TYPE ).
        APPEND LS_POSTING_RESULT TO MT_POSTING_RESULT.
      ENDLOOP.

      IF LV_ERROR = ABAP_FALSE.
        APPEND LINES OF MT_POSTING_RESULT TO LT_POSTING_OK.
        CASE IV_MODE.
          WHEN C_CHECK.
            LS_POSTING_RESULT-MESSAGE = 'Posting check OK'.
          WHEN C_SIMU.
            LS_POSTING_RESULT-MESSAGE = 'Posting simulation OK'.
          WHEN C_POST.
            LS_POSTING_RESULT-MESSAGE = 'Posting done'.
        ENDCASE.
        LS_POSTING_RESULT-TYPE = 'I'.
        LS_POSTING_RESULT-TYPE_ICON = ME->GET_ICON_FORM_MESSAGE_TYPE( LS_RETURN-TYPE ).
        APPEND LS_POSTING_RESULT TO LT_POSTING_OK.
      ELSE.
        APPEND LINES OF MT_POSTING_RESULT TO LT_POSTING_ERROR.
      ENDIF.
      CLEAR MT_POSTING_RESULT.
    ENDLOOP.

    APPEND LINES OF LT_POSTING_ERROR TO MT_POSTING_RESULT.
    APPEND LINES OF LT_POSTING_OK TO MT_POSTING_RESULT.

    CASE IV_MODE.
      WHEN C_SIMU.   "Simulate
        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      WHEN C_POST.   "Posting
        IF LT_POSTING_ERROR IS NOT INITIAL.
          CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
          LS_RETURN = YCL_CA_UTILITIES=>SET_TO_BAPIRET2_ANY_MSG( IV_MSGID = 'YFI1'
                                                            IV_MSGNO = '020'
                                                            IV_MSGTY = 'E' ).
        ELSE.
          "Set data to posting tables
          ME->SAVE_DATA_IN_POSTING_TABLES( ).
          "Do commit
          CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
            IMPORTING
              RETURN = LS_RETURN.
          "Set posting done
          MV_POSTING_DONE = ABAP_TRUE.
        ENDIF.
        IF LS_RETURN IS NOT INITIAL.
          CLEAR LS_POSTING_RESULT.
          LS_POSTING_RESULT-MESSAGE = LS_RETURN-MESSAGE.
          LS_POSTING_RESULT-TYPE = LS_RETURN-TYPE.
          LS_POSTING_RESULT-TYPE_ICON = ME->GET_ICON_FORM_MESSAGE_TYPE( LS_RETURN-TYPE ).
          INSERT LS_POSTING_RESULT INTO MT_POSTING_RESULT INDEX 1.
        ENDIF.
        "Dequeue run id
        CALL FUNCTION 'DEQUEUE_EYFM_INT_POST'
          EXPORTING
            MODE_YTFM_INT_RUNID = 'E'
            MANDT               = SY-MANDT
            INT_RUNID           = LV_INT_RUNID.
    ENDCASE.

    "Set color
    LS_COLOR-COLOR-COL = COL_NORMAL.
    LOOP AT MT_POSTING_RESULT ASSIGNING FIELD-SYMBOL(<LS_POSTING_RESULT>).
      AT NEW CODE_TO_CREDIT.
        IF LS_COLOR-COLOR-INT = 1.
          LS_COLOR-COLOR-INT = 0.
        ELSE.
          LS_COLOR-COLOR-INT = 1.
        ENDIF.
      ENDAT.
      APPEND LS_COLOR TO <LS_POSTING_RESULT>-COLOR.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM020 ----
  METHOD GET_CREDIT_ITEM.

    CLEAR ES_POSTING_ITEM.
    ADD 1 TO MV_POST_ITEM.
    ES_POSTING_ITEM-ITEMNO_ACC = MV_POST_ITEM.
    ES_POSTING_ITEM-GL_ACCOUNT = IV_GL_ACCOUNT.
    ES_POSTING_ITEM-COMP_CODE = IV_COMP_CODE.
    ES_POSTING_ITEM-COSTCENTER = IV_COSTCENTER.
    ES_POSTING_ITEM-BUS_AREA = IV_BUS_AREA.
    ES_POSTING_ITEM-FUND = IV_FUND.
    ES_POSTING_ITEM-FUNDS_CTR = IV_FUND_CTR.
    ES_POSTING_ITEM-WBS_ELEMENT = IV_WBS_ELEMENT.
    ES_POSTING_ITEM-AMT_DOCCUR = - IV_AMOUNT.
    ES_POSTING_ITEM-CURRENCY = MV_CURRENCY.
    ES_POSTING_ITEM-ITEM_TEXT = IV_ITEM_TEXT.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM021 ----
  METHOD GET_DATA_FROM_RUNID_POST.

    DATA LS_COLOR TYPE LVC_S_SCOL.

    CLEAR: MT_HEADER, MT_LIST_CON_I.

    "Header data
    SELECT AMOUNT_TYPE,
           AMOUNT_MONTH_1,
           AMOUNT_MONTH_2,
           AMOUNT_MONTH_3,
           WAERS,
           AMOUNT_QUARTER,
           REFDOCNO
           FROM YTFM_INT_HEADER
           WHERE INT_RUNID = @IV_INT_RUNID
           INTO CORRESPONDING FIELDS OF TABLE @MT_HEADER.

    READ TABLE MT_HEADER ASSIGNING FIELD-SYMBOL(<LS_HEADER>) INDEX 4.
    IF SY-SUBRC = 0.
      "Set total color
      LS_COLOR-COLOR-INT = 1.
      LS_COLOR-COLOR-COL = COL_TOTAL.
      LS_COLOR-FNAME = 'AMOUNT_MONTH_1'.
      APPEND LS_COLOR TO <LS_HEADER>-COLFIELD.
      LS_COLOR-FNAME = 'AMOUNT_MONTH_2'.
      APPEND LS_COLOR TO <LS_HEADER>-COLFIELD.
      LS_COLOR-FNAME = 'AMOUNT_MONTH_3'.
      APPEND LS_COLOR TO <LS_HEADER>-COLFIELD.
      LS_COLOR-FNAME = 'WAERS'.
      APPEND LS_COLOR TO <LS_HEADER>-COLFIELD.
    ENDIF.

    LOOP AT MT_HEADER ASSIGNING <LS_HEADER> FROM 5 TO 7.
      LS_COLOR-COLOR-INT = 1.
      LS_COLOR-COLOR-COL = COL_TOTAL.
      LS_COLOR-FNAME = 'AMOUNT_QUARTER'.
      APPEND LS_COLOR TO <LS_HEADER>-COLFIELD.
    ENDLOOP.

    "Consolidated data
    SELECT * FROM YTFM_INT_CONSO WHERE INT_RUNID = @IV_INT_RUNID INTO CORRESPONDING FIELDS OF TABLE @MT_LIST_CON_I.

    "Set MCA doc number
    READ TABLE MT_HEADER INTO DATA(LS_HEADER) INDEX 7.   "MCA line
    IF SY-SUBRC = 0 AND LS_HEADER-REFDOCNO IS NOT INITIAL.
      LOOP AT MT_LIST_CON_I ASSIGNING FIELD-SYMBOL(<LS_LIST_CON_I>) WHERE MCA_CREDIT_QUARTER <> 0.
        <LS_LIST_CON_I>-MCA_REFDOC = LS_HEADER-REFDOCNO.
      ENDLOOP.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM022 ----
  METHOD GET_DEBIT_ITEM.

    CLEAR ES_POSTING_ITEM.
    ADD 1 TO MV_POST_ITEM.
    ES_POSTING_ITEM-ITEMNO_ACC = MV_POST_ITEM.
    ES_POSTING_ITEM-GL_ACCOUNT = '0007044011'.
    ES_POSTING_ITEM-FUNDS_CTR = 'UNESCO'.
    ES_POSTING_ITEM-AMT_DOCCUR = IV_AMOUNT.
    ES_POSTING_ITEM-CURRENCY = MV_CURRENCY.
    ES_POSTING_ITEM-BUS_AREA = 'PFF'.
    ES_POSTING_ITEM-FUND = 'PFF'.
    ES_POSTING_ITEM-COSTCENTER = '0000123001'.
    ES_POSTING_ITEM-ITEM_TEXT = IV_ITEM_TEXT.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM023 ----
  METHOD GET_FUND_CENTER_FROM_FUND.

    DATA LV_YEAR TYPE GJAHR.

    CLEAR RV_FISTL.
    "Get it from budget
    SELECT SINGLE RFUNDSCTR FROM FMBDT WHERE RYEAR = @MV_YEAR
                                       AND   RFIKRS = @MV_FIKRS
                                       AND   RFUND = @IV_FUND
                  INTO @RV_FISTL.

    IF RV_FISTL IS INITIAL.
      "get it from espenses for fiscal year
      SELECT SINGLE RFISTL FROM FMIT WHERE RYEAR = @MV_YEAR
                                     AND   FIKRS = @MV_FIKRS
                                     AND   RFONDS = @IV_FUND
                    INTO @RV_FISTL.
    ENDIF.

    IF RV_FISTL IS INITIAL.
      "get it from espenses for previous fiscal year
      LV_YEAR = MV_YEAR - 1.
      SELECT SINGLE RFISTL FROM FMIT WHERE RYEAR = @LV_YEAR
                                     AND   FIKRS = @MV_FIKRS
                                     AND   RFONDS = @IV_FUND
                    INTO @RV_FISTL.
    ENDIF.

    IF RV_FISTL IS INITIAL.
      "get it from espenses without fiscal year
      SELECT SINGLE RFISTL FROM FMIT WHERE FIKRS = @MV_FIKRS
                                     AND   RFONDS = @IV_FUND
                    INTO @RV_FISTL.
    ENDIF.


  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM024 ----
  METHOD GET_ICON_FORM_MESSAGE_TYPE.

    CASE IV_MSGTY.
      WHEN 'A'.
        WRITE ICON_FAILURE TO RV_ICON AS ICON.
      WHEN 'E'.
        WRITE ICON_LED_RED TO RV_ICON AS ICON.
      WHEN 'W'.
        WRITE ICON_LED_YELLOW TO RV_ICON AS ICON.
      WHEN 'I' OR 'S'.
        WRITE ICON_LED_GREEN TO RV_ICON AS ICON.
      WHEN OTHERS.
        WRITE ICON_LED_INACTIVE TO RV_ICON AS ICON.
    ENDCASE.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM025 ----
  METHOD GET_RUNID.

    EV_INT_RUNID = |{ MV_YEAR }Q{ MV_QUARTER }|.
    CLEAR ES_INT_RUNID.
    SELECT SINGLE * FROM YTFM_INT_RUNID WHERE INT_RUNID = @EV_INT_RUNID INTO @ES_INT_RUNID.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM026 ----
  METHOD HANDLE_LINK_CLICK_HEADER.

    FIELD-SYMBOLS <LS_LIST> TYPE ANY.
    FIELD-SYMBOLS <LV_FIELD> TYPE ANY.
    DATA LV_REFDOCNO TYPE FIN_REFDOCNO.

    CHECK ROW IS NOT INITIAL.

    READ TABLE MT_HEADER INTO DATA(LS_HEADER) INDEX ROW.

    CASE COLUMN.

      WHEN 'REFDOCNO'.
        IF LS_HEADER-REFDOCNO IS NOT INITIAL.
          SET PARAMETER ID 'BUK' FIELD LS_HEADER-REFDOCNO(4).
          SET PARAMETER ID 'BLN' FIELD LS_HEADER-REFDOCNO+4(10).
          SET PARAMETER ID 'GJR' FIELD LS_HEADER-REFDOCNO+14(4).
          CALL TRANSACTION 'FB03' AND SKIP FIRST SCREEN.
        ENDIF.
    ENDCASE.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM027 ----
  METHOD PREPARE_DATA_FOR_POSTING.

    DATA LS_POSTING TYPE TY_POSTING.
    DATA LS_POSTING_ITEM TYPE TY_POSTING_ITEM.
    DATA LV_INSTITUTE TYPE YE_FI_INSTITUTE.
    DATA LV_GL_ACCOUNT TYPE HKONT.
    DATA LV_AMOUNT TYPE YE_FM_INTEREST_DISTRIBUTED.

    "Projects
    LOOP AT MT_LIST_CON_I INTO DATA(LS_LIST) WHERE POSTING_RULE = 'PROJ'.

      CHECK LS_LIST-INT_DISTRIB_QUARTER IS NOT INITIAL.

      CLEAR: LS_POSTING, MV_POST_ITEM.
      LS_POSTING-CODE_TO_CREDIT = LS_LIST-CODE_TO_CREDIT.
      LS_POSTING-COMP_CODE = MV_BUKRS.
      LS_POSTING-HEADER_TXT = |Int. distr { MV_YEAR } Q{ MV_QUARTER } PROJ|.

      "Debit item
      ME->GET_DEBIT_ITEM( EXPORTING IV_ITEM_TEXT = |Interest distribution { MV_YEAR } Q{ MV_QUARTER } - PROJ|
                                    IV_AMOUNT = LS_LIST-INT_DISTRIB_QUARTER
                          IMPORTING ES_POSTING_ITEM = LS_POSTING_ITEM ).
      APPEND LS_POSTING_ITEM TO LS_POSTING-ITEM.

      "Credit item
      ME->GET_CREDIT_ITEM( EXPORTING IV_GL_ACCOUNT = '0007044011'
                                     IV_BUS_AREA = 'PFF'
                                     IV_FUND = LS_LIST-CODE_TO_CREDIT
                                     IV_FUND_CTR = ME->GET_FUND_CENTER_FROM_FUND( IV_FUND = |{ LS_LIST-CODE_TO_CREDIT }| )
                                     IV_WBS_ELEMENT = LS_LIST-CODE_TO_CREDIT
                                     IV_ITEM_TEXT = |Interest distribution { MV_YEAR } Q{ MV_QUARTER } - PROJ|
                                     IV_AMOUNT = LS_LIST-INT_DISTRIB_QUARTER
                           IMPORTING ES_POSTING_ITEM = LS_POSTING_ITEM ).
      APPEND LS_POSTING_ITEM TO LS_POSTING-ITEM.

      APPEND LS_POSTING TO MT_POSTING.

    ENDLOOP.

    "Institutes
    CLEAR: LV_AMOUNT, LS_POSTING.
    MV_POST_ITEM = 1.
    LOOP AT MT_LIST_CON_I INTO LS_LIST WHERE POSTING_RULE = 'IBC'.

      CHECK LS_LIST-INT_DISTRIB_QUARTER IS NOT INITIAL.
      LS_POSTING-CODE_TO_CREDIT = C_IBC_CONSOLIDATION.
      LS_POSTING-COMP_CODE = MV_BUKRS.
      LS_POSTING-HEADER_TXT = |Interco int distr { MV_YEAR } Q{ MV_QUARTER }|.

      "Credit item
      SPLIT LS_LIST-CODE_TO_CREDIT AT ' - ' INTO LV_INSTITUTE LV_GL_ACCOUNT.
      "Get institute company code
      READ TABLE MT_INST INTO DATA(LS_INST) WITH KEY INSTITUTE = LV_INSTITUTE.
      "Get institute attributes
      READ TABLE MT_INST_INT INTO DATA(LS_INST_INT) WITH KEY INSTITUTE = LV_INSTITUTE.

      ME->GET_CREDIT_ITEM( EXPORTING IV_GL_ACCOUNT = '0007044011'
                                     IV_COMP_CODE = LS_INST-BUKRS
                                     IV_BUS_AREA = LS_INST_INT-GSBER
                                     IV_COSTCENTER = LS_INST_INT-KOSTL
                                     IV_FUND = LS_INST_INT-FINCODE
                                     IV_FUND_CTR = LS_INST_INT-FISTL
                                     IV_WBS_ELEMENT = SPACE
                                     IV_ITEM_TEXT = |Interco interest distribution { MV_YEAR } Q{ MV_QUARTER } - { LV_INSTITUTE }|
                                     IV_AMOUNT = LS_LIST-INT_DISTRIB_QUARTER
                           IMPORTING ES_POSTING_ITEM = LS_POSTING_ITEM ).
      APPEND LS_POSTING_ITEM TO LS_POSTING-ITEM.

      ADD LS_LIST-INT_DISTRIB_QUARTER TO LV_AMOUNT.

    ENDLOOP.
    IF SY-SUBRC = 0 AND LV_AMOUNT IS NOT INITIAL.
      "Debit item
      CLEAR MV_POST_ITEM.
      ME->GET_DEBIT_ITEM( EXPORTING IV_ITEM_TEXT = |Interco interest distribution { MV_YEAR } Q{ MV_QUARTER }|
                                    IV_AMOUNT = LV_AMOUNT
                          IMPORTING ES_POSTING_ITEM = LS_POSTING_ITEM ).
      INSERT LS_POSTING_ITEM INTO LS_POSTING-ITEM INDEX 1.

      APPEND LS_POSTING TO MT_POSTING.
    ENDIF.

    "Put MCA
    READ TABLE MT_HEADER INTO DATA(LS_HEADER_MCA) WITH KEY AMOUNT_TYPE = C_MCA_CREDIT.
    IF SY-SUBRC = 0 AND LS_HEADER_MCA-AMOUNT_QUARTER IS NOT INITIAL.
      CLEAR: LS_POSTING, LS_POSTING_ITEM, MV_POST_ITEM.
      LS_POSTING-CODE_TO_CREDIT = C_MCA_CREDIT.
      LS_POSTING-COMP_CODE = MV_BUKRS.
      LS_POSTING-HEADER_TXT = |Int. distr { MV_YEAR } Q{ MV_QUARTER } - MCA|.
      "Debit item
      ME->GET_DEBIT_ITEM( EXPORTING IV_ITEM_TEXT = |Interest distribution { MV_YEAR } Q{ MV_QUARTER } - MCA|
                                    IV_AMOUNT = LS_HEADER_MCA-AMOUNT_QUARTER
                          IMPORTING ES_POSTING_ITEM = LS_POSTING_ITEM ).
      APPEND LS_POSTING_ITEM TO LS_POSTING-ITEM.
      "Credit line
      ME->GET_CREDIT_ITEM( EXPORTING IV_GL_ACCOUNT = '0007044011'
                                     IV_COMP_CODE = SPACE
                                     IV_BUS_AREA = 'PFF'
                                     IV_FUND = MV_FUND_MCA_POSTING
                                     IV_FUND_CTR = 'UNESCO'
                                     IV_WBS_ELEMENT = MV_FUND_MCA_POSTING
                                     IV_ITEM_TEXT = |Interest distribution { MV_YEAR } Q{ MV_QUARTER } - MCA|
                                     IV_AMOUNT = LS_HEADER_MCA-AMOUNT_QUARTER
                           IMPORTING ES_POSTING_ITEM = LS_POSTING_ITEM ).
      APPEND LS_POSTING_ITEM TO LS_POSTING-ITEM.
      APPEND LS_POSTING TO MT_POSTING.
    ENDIF.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM028 ----
  METHOD SAVE_DATA_IN_POSTING_TABLES.

    DATA LT_HEADER TYPE YTTFM_INT_HEADER.
    DATA LS_HEADER TYPE LINE OF YTTFM_INT_HEADER.

    "Get runid
    ME->GET_RUNID( IMPORTING EV_INT_RUNID = DATA(LV_INT_RUNID) ).

    LOOP AT MT_HEADER INTO DATA(LS_HEAD).
      MOVE-CORRESPONDING LS_HEAD TO LS_HEADER.
      IF LS_HEAD-AMOUNT_TYPE = C_MCA_CREDIT.
        READ TABLE MT_POSTING_RESULT INTO DATA(LS_POSTING_RESULT) WITH KEY CODE_TO_CREDIT = LS_HEAD-AMOUNT_TYPE.
        IF SY-SUBRC = 0.
          LS_HEADER-REFDOCNO = |{ LS_POSTING_RESULT-BUKRS }{ LS_POSTING_RESULT-BELNR }{ LS_POSTING_RESULT-GJAHR }|.
        ENDIF.
      ENDIF.
      APPEND LS_HEADER TO LT_HEADER.
    ENDLOOP.

    "Set FI document in consolidated table
    LOOP AT MT_LIST_CON_I ASSIGNING FIELD-SYMBOL(<LS_ITEM>).
      CASE <LS_ITEM>-POSTING_RULE.
        WHEN 'PROJ'.
          READ TABLE MT_POSTING_RESULT INTO LS_POSTING_RESULT WITH KEY CODE_TO_CREDIT = <LS_ITEM>-CODE_TO_CREDIT.
        WHEN 'IBC'.
          READ TABLE MT_POSTING_RESULT INTO LS_POSTING_RESULT WITH KEY CODE_TO_CREDIT = C_IBC_CONSOLIDATION.
        WHEN OTHERS.
          CONTINUE.
      ENDCASE.
      CHECK SY-SUBRC = 0.
      <LS_ITEM>-REFDOCNO = |{ LS_POSTING_RESULT-BUKRS }{ LS_POSTING_RESULT-BELNR }{ LS_POSTING_RESULT-GJAHR }|.
    ENDLOOP.

    CALL FUNCTION 'Y_FM_UPDATE_INT_DISTRIBUTION' IN UPDATE TASK
      EXPORTING
        IV_INT_RUNID = LV_INT_RUNID
        IV_YEAR      = MV_YEAR
        IV_QUARTER   = MV_QUARTER
        IT_HEADER    = LT_HEADER
        IT_CONSO     = MT_LIST_CON_I
      EXCEPTIONS
        ERROR_UPDATE = 1
        OTHERS       = 2.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM029 ----
  METHOD YIF_ALV_EXTENDED~ADD_ALV_PROPERTIES.

    DATA LO_COLUMN TYPE REF TO CL_SALV_COLUMN_TABLE.

    CO_SALV_TABLE->GET_FUNCTIONS( )->SET_ALL( ).
    CO_SALV_TABLE->GET_COLUMNS( )->SET_OPTIMIZE( ABAP_TRUE ).

    TRY.
        CO_SALV_TABLE->GET_COLUMNS( )->SET_COLOR_COLUMN( 'COLOR' ).
      CATCH CX_SALV_DATA_ERROR.
    ENDTRY.

    TRY.
        LO_COLUMN ?= CO_SALV_TABLE->GET_COLUMNS( )->GET_COLUMN( 'TYPE' ).
        LO_COLUMN->SET_VISIBLE( ABAP_FALSE ).
      CATCH CX_SALV_NOT_FOUND.
    ENDTRY.

    TRY.
        LO_COLUMN ?= CO_SALV_TABLE->GET_COLUMNS( )->GET_COLUMN( 'TYPE_ICON' ).
        LO_COLUMN->SET_ICON( ABAP_TRUE ).
      CATCH CX_SALV_NOT_FOUND.
    ENDTRY.

  ENDMETHOD.

