      IF SY-SUBRC = 0.
        LV_TABIX = SY-TABIX.
        IF LS_NEW-DEDUCTION <> LS_OLD-DEDUCTION OR LS_NEW-WAERS <> LS_OLD-WAERS.
          LS_NEW-MUNAM = SY-UNAME.
          LS_NEW-MDATE = SY-DATUM.
          APPEND LS_NEW TO LT_UPDATE.
        ENDIF.
