* ---- YCL_FM_INTEREST_DISTRIB_BL====CM008 ----
  METHOD SET_MODIF_TO_INT_DISTR.

    TYPES LTTY_INT_DISTR TYPE TABLE OF YTFM_INT_DISTR.
    FIELD-SYMBOLS <LT_MODIFIED> TYPE LTTY_INT_DISTR.

    ASSIGN ER_DATA_CHANGED->MP_MOD_ROWS->* TO <LT_MODIFIED>.

    LOOP AT ER_DATA_CHANGED->MT_GOOD_CELLS INTO DATA(LS_GOOD_CELLS).
      "Check empty values
      CASE LS_GOOD_CELLS-FIELDNAME.
        WHEN 'IYEAR' OR 'IMONTH'.
          IF LS_GOOD_CELLS-VALUE IS INITIAL OR LS_GOOD_CELLS-VALUE CO '0 '.
            CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
              EXPORTING
                I_MSGID     = 'YFM1'
                I_MSGNO     = '027'
                I_MSGTY     = 'E'
                I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
            MV_ERROR = ABAP_TRUE.
          ENDIF.
      ENDCASE.
      "Check periods
      IF LS_GOOD_CELLS-FIELDNAME = 'IYEAR' OR LS_GOOD_CELLS-FIELDNAME = 'IMONTH'.
        "Get corresponing full row
        READ TABLE <LT_MODIFIED> INTO DATA(LS_MODIFIED) INDEX LS_GOOD_CELLS-TABIX.
        IF SY-SUBRC = 0.
          READ TABLE MT_PERIOD TRANSPORTING NO FIELDS WITH KEY GJAHR = LS_MODIFIED-IYEAR
                                                               MONTH = LS_MODIFIED-IMONTH.
          IF SY-SUBRC <> 0.
            CALL METHOD ER_DATA_CHANGED->ADD_PROTOCOL_ENTRY
              EXPORTING
                I_MSGID     = 'YFM1'
                I_MSGNO     = '028'
                I_MSGTY     = 'E'
                I_MSGV1     = LS_MODIFIED-IYEAR
                I_MSGV2     = LS_MODIFIED-IMONTH
                I_FIELDNAME = LS_GOOD_CELLS-FIELDNAME
                I_ROW_ID    = LS_GOOD_CELLS-ROW_ID.
            MV_ERROR = ABAP_TRUE.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.

*    "Manage deleted lines
*    LOOP AT er_data_changed->mt_deleted_rows INTO DATA(ls_deleted_row).
*
*    ENDLOOP.

  ENDMETHOD.

