    DATA LS_LAYOUT TYPE LVC_S_LAYO.

    MV_FIKRS = IV_FIKRS.

    "Set default value
    MS_INT_SUBST_DEFAULT-BEGDA = |{ SY-DATUM(4) }0101|.
