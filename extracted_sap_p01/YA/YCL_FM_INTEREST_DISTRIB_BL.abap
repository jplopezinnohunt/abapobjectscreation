    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'BEGDA' IV_KEY = ABAP_TRUE IV_EDIT = ABAP_TRUE IV_AUTO_VALUE = ABAP_TRUE  ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'ENDDA' IV_EDIT = ABAP_TRUE IV_AUTO_VALUE = ABAP_TRUE ).
    ME->SET_FIELDCAT_PROPERTY( IV_FIELDNAME = 'FINCODE_TARGET' IV_EDIT = ABAP_TRUE ).

