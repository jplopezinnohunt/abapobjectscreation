* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01L ----
  METHOD HANDLE_LINK_CLICK.

    FIELD-SYMBOLS <LS_LIST> TYPE ANY.
    FIELD-SYMBOLS <LV_FIELD> TYPE ANY.
    DATA LV_REFDOCNO TYPE FIN_REFDOCNO.

    CHECK ROW IS NOT INITIAL.

    IF MV_LIST_TYPE = 'C' OR MV_LIST_TYPE = 'P'.
      READ TABLE MT_LIST_CON_I ASSIGNING <LS_LIST> INDEX ROW.
    ELSEIF MV_LIST_TYPE = 'D'.
      READ TABLE MT_LIST_DET_I ASSIGNING <LS_LIST> INDEX ROW.
    ELSE.
      EXIT.
    ENDIF.

    CASE COLUMN.

      WHEN 'PSPID'.
        ASSIGN COMPONENT COLUMN OF STRUCTURE <LS_LIST> TO <LV_FIELD>.
        IF <LV_FIELD> IS ASSIGNED.
          "Call transaction CJ20N
          YCL_PS_PROJECT_UTILITIES=>CALL_PROJECT_TRANSACTION( IV_PROJECT = <LV_FIELD>
                                                              IV_MODE = 'D' ).
        ENDIF.

      WHEN 'CODE_TO_CREDIT'.
        ASSIGN COMPONENT 'FINCODE_STATUS' OF STRUCTURE <LS_LIST> TO <LV_FIELD>.
        IF <LV_FIELD> IS ASSIGNED.
          IF <LV_FIELD> IS INITIAL.
            EXIT.
          ENDIF.
        ENDIF.

        UNASSIGN <LV_FIELD>.
        ASSIGN COMPONENT 'POSTING_CHECK' OF STRUCTURE <LS_LIST> TO <LV_FIELD>.
        IF <LV_FIELD> IS ASSIGNED.
          IF <LV_FIELD> IS INITIAL.
            EXIT.
          ENDIF.
        ENDIF.

        UNASSIGN <LV_FIELD>.
        ASSIGN COMPONENT COLUMN OF STRUCTURE <LS_LIST> TO <LV_FIELD>.
        IF <LV_FIELD> IS ASSIGNED.
          SELECT SINGLE FIKRS FROM T001 WHERE BUKRS = @MV_BUKRS INTO @DATA(LV_FIKRS).
          SET PARAMETER ID 'FIK' FIELD LV_FIKRS.
          SET PARAMETER ID 'FIC' FIELD <LV_FIELD>.
          CALL TRANSACTION 'FM5S' AND SKIP FIRST SCREEN.
        ENDIF.

      WHEN 'REFDOCNO' OR 'MCA_REFDOC'.
        ASSIGN COMPONENT COLUMN OF STRUCTURE <LS_LIST> TO <LV_FIELD>.
        LV_REFDOCNO = <LV_FIELD>.
        IF SY-SUBRC = 0.
          SET PARAMETER ID 'BUK' FIELD LV_REFDOCNO(4).
          SET PARAMETER ID 'BLN' FIELD LV_REFDOCNO+4(10).
          SET PARAMETER ID 'GJR' FIELD LV_REFDOCNO+14(4).
          CALL TRANSACTION 'FB03' AND SKIP FIRST SCREEN.
        ENDIF.

    ENDCASE.

  ENDMETHOD.

* ---- YCL_FM_INTEREST_DISTRIB_BL====CM01M ----
  METHOD DISPLAY_LOG.

    DATA LV_DATE TYPE D.

    CHECK MV_TABLE_NAME IS NOT INITIAL.

    LV_DATE = SY-DATUM - 90.
    LV_DATE+6(2) = '01'.

    "Ask for begin date for log
    CALL FUNCTION 'TR_POPUP_INPUT_DATE'
      EXPORTING
        IV_TITLE               = 'Begin date for log'
        IV_DESCRIPTION1        = 'Display log from'
*       IV_DESCRIPTION2        =
        IV_DATE                = LV_DATE
      IMPORTING
        EV_DATE                = LV_DATE
      EXCEPTIONS
        ACTION_ABORTED_BY_USER = 1
        VALUE_NOT_CHANGED      = 2
        OTHERS                 = 3.

    IF SY-SUBRC <> 0 AND SY-SUBRC <> 2.
      EXIT.
    ENDIF.

    SUBMIT RSVTPROT WITH CUSOBJ = MV_TABLE_NAME
                    WITH DBEG = LV_DATE
                    WITH OBJFIRST = SPACE
                    WITH TABFIRST = 'X'
                    WITH ALV_GRID = ABAP_TRUE
                    AND RETURN.

  ENDMETHOD.

