* ---- YCL_FM_FUND_CASH_BAL_WITH_PS==CM006 ----
  METHOD GET_PS_DATA.

    SELECT P~PSPNR AS PROJ_PSPNR,
           P~PSPID,
           P~POSTU,
           P~PWHIE,
           P~PROFL,
           P~BPROF,
           W~PSPNR AS PRPS_PSPNR,
           W~POSID,
           W~PBUKR,
           W~PGSBR,
           W~PRART,
           W~STUFE,
           W~POST1 AS DESCR,
           W~YYE_DONOR,
           W~YYE_EXEC_AGENCY,
           W~YYE_IMPL_AGENCY,
           W~YYE_TYP_SOU,
           W~YYE_EXEC,
           W~YYE_PRCRT
           FROM PROJ AS P
           LEFT OUTER JOIN PRPS AS W ON W~POSID = P~PSPID
           FOR ALL ENTRIES IN @MT_FUND
           WHERE PSPID = @MT_FUND-FUND_PSPID
           AND   VBUKR = @MP_BUKRS
           INTO TABLE @MT_PROJ_WBS.

  ENDMETHOD.

* ---- YCL_FM_FUND_CASH_BAL_WITH_PS==CM007 ----
  METHOD PREPARE_DATA.

    DATA LS_LIST TYPE TY_LIST.

    LOOP AT MT_FUND INTO DATA(LS_FUND).
      CLEAR LS_LIST.
      "Fund data
      MOVE-CORRESPONDING LS_FUND TO LS_LIST.
      "Fund assignment to C5
      LOOP AT MT_FUND_C5 INTO DATA(LS_FUND_C5) WHERE FIKRS = LS_FUND-FIKRS
                                               AND   FINCODE = LS_FUND-FINCODE
                                               AND   YEAR_FROM <= MP_BEGPER(4)
                                               AND   YEAR_TO >= MP_BEGPER(4).
        EXIT.
      ENDLOOP.
      IF SY-SUBRC = 0.
        LS_LIST-C5_ID = LS_FUND_C5-C5_ID.
        LS_LIST-C5_SEL = LS_FUND_C5-C5_SEL.
        LS_LIST-FM_OUTPUT = LS_FUND_C5-FM_OUTPUT.
        LS_LIST-OTYPE = LS_FUND_C5-OTYPE.
        LS_LIST-ONAME = LS_FUND_C5-ONAME.
        LS_LIST-OTEXT = LS_FUND_C5-OTEXT.
      ENDIF.
      "PS data
      READ TABLE MT_PROJ_WBS INTO DATA(LS_PROJ_WBS) WITH KEY PSPID = LS_FUND-FUND_PSPID.
      IF SY-SUBRC = 0.
        MOVE-CORRESPONDING LS_PROJ_WBS TO LS_LIST.
      ELSEIF MP_PROJ = ABAP_TRUE.
        CONTINUE.
      ENDIF.
      "WBS long text
      LS_LIST-DESCR = ME->READ_WBS_TEXT( LS_LIST-PRPS_PSPNR ).
      "Amounts
      READ TABLE MT_FUND_AMOUNT INTO DATA(LS_FUND_AMOUNT) WITH KEY FINCODE = LS_FUND-FINCODE.
      IF SY-SUBRC = 0.
        MOVE-CORRESPONDING LS_FUND_AMOUNT TO LS_LIST.
      ENDIF.
      "Calculate balance
      LS_LIST-BALANCE = LS_LIST-CF + LS_LIST-REVENUE + LS_LIST-GAINS + LS_LIST-COST.
      "Set to ALV list
      APPEND LS_LIST TO MT_LIST.
    ENDLOOP.

  ENDMETHOD.

