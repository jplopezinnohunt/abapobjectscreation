* ---- YCL_FM_FUND_CASH_BAL_WITH_PS==CM00A ----
  METHOD READ_WBS_TEXT.

    DATA LT_LINES TYPE TABLE OF TLINE.
    DATA LV_TDNAME TYPE THEAD-TDNAME.
    DATA LT_STRING TYPE STRING_TABLE.

    LV_TDNAME = |E{ IV_PSPNR }|.

    CALL FUNCTION 'READ_TEXT'
      EXPORTING
*       CLIENT                  = SY-MANDT
        ID                      = 'LTXT'
        LANGUAGE                = 'E'
        NAME                    = LV_TDNAME
        OBJECT                  = 'PMS'
*       ARCHIVE_HANDLE          = 0
*       LOCAL_CAT               = ' '
* IMPORTING
*       HEADER                  =
*       OLD_LINE_COUNTER        =
      TABLES
        LINES                   = LT_LINES
      EXCEPTIONS
        ID                      = 1
        LANGUAGE                = 2
        NAME                    = 3
        NOT_FOUND               = 4
        OBJECT                  = 5
        REFERENCE_CHECK         = 6
        WRONG_ACCESS_TO_ARCHIVE = 7
        OTHERS                  = 8.

    CHECK LT_LINES IS NOT INITIAL.

    CALL FUNCTION 'CONVERT_ITF_TO_STREAM_TEXT'
      EXPORTING
        LANGUAGE     = 'E'
        LF           = ABAP_TRUE
      IMPORTING
        STREAM_LINES = LT_STRING
      TABLES
        ITF_TEXT     = LT_LINES.

    LOOP AT LT_STRING INTO DATA(LV_STRING).
      DATA(LV_TABIX) = SY-TABIX.
      REPLACE ALL OCCURRENCES OF '#' IN LV_STRING WITH SPACE.
      IF LV_TABIX = 1.
        RV_TEXT = LV_STRING.
      ELSE.
        IF LV_STRING IS INITIAL.
          CONTINUE.
        ENDIF.
        CONCATENATE RV_TEXT LV_STRING INTO RV_TEXT SEPARATED BY SPACE.
      ENDIF.
    ENDLOOP.

  ENDMETHOD.

* ---- YCL_FM_FUND_CASH_BAL_WITH_PS==CM00B ----
  METHOD GET_DATA_FROM_FMIT.

    DATA LS_FUND_FMIT TYPE TY_FUND_FMIT.
    DATA LV_NUM(2) TYPE N.
    DATA LV_PERIO TYPE YE_PERIOD.
    DATA LV_FIELDNAME TYPE FIELDNAME.
    DATA LS_FUND_AMOUNT TYPE TY_FUND_AMOUNT.
    FIELD-SYMBOLS <AMOUNT> TYPE ANY.

    SELECT * FROM FMIT WHERE RLDNR = '9A'
                       AND   RRCTY = '0'
                       AND   RVERS = '000'
                       AND   RYEAR >= @MP_BEGPER(4)
                       AND   RYEAR <= @MP_ENDPER(4)
                       AND   RBUKRS = @MP_BUKRS
                       AND   RFONDS IN @MR_FUND
                       AND   RBUSA IN @MR_GSBER
                       AND   RWRTTP IN @MR_WRTTP
            INTO TABLE @MT_FMIT.

    LOOP AT MT_FMIT INTO DATA(LS_FMIT).
      "Collect fund
      LS_FUND_FMIT-FIKRS = MV_FIKRS.
      LS_FUND_FMIT-FINCODE = LS_FMIT-RFONDS.
      INSERT LS_FUND_FMIT INTO TABLE MT_FUND_FMIT.
      "Get amounts
      CLEAR: LV_NUM, LV_PERIO, LS_FUND_AMOUNT.
      LS_FUND_AMOUNT-FINCODE = LS_FMIT-RFONDS.
      LS_FUND_AMOUNT-WAERS = MV_FM_WAERS.
      "Carried formward amount
      LS_FUND_AMOUNT-CF = LS_FMIT-HSLVT.
      DO 16 TIMES.
        ADD 1 TO LV_NUM.
        LV_PERIO = |{ LS_FMIT-RYEAR }{ LV_NUM }|.
        CHECK LV_PERIO BETWEEN MP_BEGPER AND MP_ENDPER.
        LV_FIELDNAME = |LS_FMIT-HSL{ LV_NUM }|.
        ASSIGN (LV_FIELDNAME) TO <AMOUNT>.
        IF LS_FMIT-RFIPEX IN MT_FIPEX_REVENUE.
          ADD <AMOUNT> TO LS_FUND_AMOUNT-REVENUE.
        ELSEIF  LS_FMIT-RFIPEX IN MT_FIPEX_GAINS.
          ADD <AMOUNT> TO LS_FUND_AMOUNT-GAINS.
        ELSE.
          ADD <AMOUNT> TO LS_FUND_AMOUNT-COST.
        ENDIF.
      ENDDO.
      COLLECT LS_FUND_AMOUNT INTO MT_FUND_AMOUNT.
    ENDLOOP.

  ENDMETHOD.

