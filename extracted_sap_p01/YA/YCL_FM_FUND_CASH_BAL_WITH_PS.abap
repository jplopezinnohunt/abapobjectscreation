* ---- YCL_FM_FUND_CASH_BAL_WITH_PS==CM001 ----
  METHOD GET_DATA.

    ME->INITIALIZE_DATA( ).
    ME->GET_DATA_FROM_FMIT( ).
    CHECK MT_FUND_FMIT IS NOT INITIAL.
    ME->GET_FUNDS( ).
    CHECK MT_FUND IS NOT INITIAL.
    ME->GET_PS_DATA( ).
    ME->PREPARE_DATA( ).

  ENDMETHOD.

* ---- YCL_FM_FUND_CASH_BAL_WITH_PS==CM002 ----
  METHOD INITIALIZE_DATA.

    "Get FM area from company code
    SELECT SINGLE FIKRS FROM T001 WHERE BUKRS = @MP_BUKRS INTO @MV_FIKRS.

    "Get local currency
    SELECT SINGLE WAERS FROM FM01 WHERE FIKRS = @MV_FIKRS INTO @MV_FM_WAERS.

    "Get commitment item 'REVENUE'
    APPEND VALUE #( SIGN = 'I' OPTION = 'EQ' LOW = 'REVENUE' ) TO MT_FIPEX_REVENUE.
    "Get commitment item 'GAINS'
    APPEND VALUE #( SIGN = 'I' OPTION = 'EQ' LOW = 'GAINS' ) TO MT_FIPEX_GAINS.

  ENDMETHOD.

* ---- YCL_FM_FUND_CASH_BAL_WITH_PS==CM004 ----
  METHOD GET_FUNDS.

    "Get fund from selection
    SELECT DISTINCT A~FIKRS,
                    A~FINCODE,
                    A~TYPE,
                    B~BESCHR,
                    A~DATAB,
                    A~DATBIS,
                    A~FINCODE AS FUND_PSPID
                    FROM FMFINCODE AS A
                    INNER JOIN FMFINT AS B ON  B~SPRAS = @SY-LANGU
                                           AND B~FIKRS = A~FIKRS
                                           AND B~FINCODE = A~FINCODE
                    LEFT OUTER JOIN YTFM_FUND_C5 AS C ON  C~FIKRS = A~FIKRS
                                                      AND C~FINCODE = A~FINCODE
                    FOR ALL ENTRIES IN @MT_FUND_FMIT
                    WHERE A~FIKRS = @MT_FUND_FMIT-FIKRS
                    AND   A~FINCODE = @MT_FUND_FMIT-FINCODE
                    AND   C~C5_ID IN @MR_C5
                    INTO TABLE @MT_FUND.

    CHECK MT_FUND IS NOT INITIAL.

    "Get C5 assignment for fiscal year
    SELECT A~FIKRS, A~FINCODE, A~C5_ID, C~YEAR_FROM, C~YEAR_TO, A~C5_SEL, A~FM_OUTPUT, O~OTYPE, T~ONAME, T~OTEXT
           FROM YTFM_FUND_C5 AS A
           INNER JOIN YTFM_C5 AS C ON C~C5_ID = A~C5_ID
           LEFT OUTER JOIN YTFM_OUTPUT AS O ON O~FM_OUTPUT = A~FM_OUTPUT
           LEFT OUTER JOIN YTFM_OUTPUT_T AS T ON  T~SPRSL = @SY-LANGU
                                              AND T~FM_OUTPUT = A~FM_OUTPUT
           FOR ALL ENTRIES IN @MT_FUND
           WHERE A~FIKRS = @MT_FUND-FIKRS
           AND   A~FINCODE = @MT_FUND-FINCODE
           AND   C~YEAR_FROM <= @MP_ENDPER(4)
           AND   C~YEAR_TO >= @MP_BEGPER(4)
           INTO TABLE @MT_FUND_C5.

  ENDMETHOD.

