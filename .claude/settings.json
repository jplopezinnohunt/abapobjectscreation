{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python brain_v2/session_start_hook.py",
            "timeout": 15,
            "statusMessage": "Loading Brain INDEX (lean) + daily curation check..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python brain_v2/stop_durability_hook.py",
            "timeout": 15,
            "statusMessage": "Durability gate: checking uncommitted source..."
          },
          {
            "type": "command",
            "command": "python brain_v2/stop_steward_hook.py",
            "timeout": 15,
            "statusMessage": "Knowledge-promotion gate: steward check before close..."
          },
          {
            "type": "command",
            "command": "python brain_v2/stop_integrity_hook.py",
            "timeout": 20,
            "statusMessage": "Integrity gate: checking artefacts, backup and arsenal..."
          },
          {
            "type": "command",
            "command": "python Zagentexecution/quality_checks/run_all_tests.py"
          },
          {
            "type": "command",
            "command": "python Zagentexecution/quality_checks/rules_mechanization_check.py --solo-criticas --top 5"
          },
          {
            "type": "command",
            "command": "python Zagentexecution/quality_checks/extracted_corpus_integrity_check.py"
          },
          {
            "type": "command",
            "command": "python Zagentexecution/quality_checks/query_discipline_check.py"
          },
          {
            "type": "command",
            "command": "python Zagentexecution/quality_checks/store_schema_check.py"
          },
          {
            "type": "command",
            "command": "python Zagentexecution/quality_checks/brain_state_enrichment_check.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python brain_v2/agent_trace_hook.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python brain_v2/agent_trace_hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python brain_v2/store_write_guard_hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
